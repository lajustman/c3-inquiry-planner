mi:Cat_5_U3_2 a mi:StandardCategory ;
  mi:categoryCode "U3.2" ;
  skos:prefLabel "The American Revolution and Its Consequences" ;
  mi:categoryDescription "Explain the multi-faceted nature of the American Revolution and its consequences." ;
  mi:inGrade mi:Grade_5 ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExpectation
    mi:Exp_5_U3_2_1 ,
    mi:Exp_5_U3_2_2 ,
    mi:Exp_5_U3_2_3 ,
    mi:Exp_5_U3_2_4 ;
  mi:isCategoryOf mi:Grade_5 .

mi:Cat_5_U3_3 a mi:StandardCategory ;
  mi:categoryCode "U3.3" ;
  skos:prefLabel "Creating New Government(s) and a New Constitution" ;
  mi:categoryDescription "Explain some of the challenges faced by the new nation under the Articles of Confederation, and analyze the development of the Constitution as a new plan for governing." ;
  mi:inGrade mi:Grade_5 ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExpectation
    mi:Exp_5_U3_3_1 ,
    mi:Exp_5_U3_3_2 ,
    mi:Exp_5_U3_3_3 ,
    mi:Exp_5_U3_3_4 ,
    mi:Exp_5_U3_3_5 ,
    mi:Exp_5_U3_3_6 ,
    mi:Exp_5_U3_3_7 ,
    mi:Exp_5_U3_3_8 ;
  mi:isCategoryOf mi:Grade_5 .

