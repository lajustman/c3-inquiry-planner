#################################################################
# Categories
#################################################################
mi:Cat_5_P3_1 a mi:StandardCategory ;
  mi:categoryCode "P3.1" ;
  skos:prefLabel "Identifying and Analyzing Public Issues" ;
  mi:categoryDescription "Clearly state a problem as public policy issue, analyze various perspectives, and generate and evaluate possible alternative resolutions." ;
  mi:inGrade mi:Grade_5 ;
  mi:inDiscipline mi:Discipline_P ;
  mi:hasExpectation
    mi:Exp_5_P3_1_1 ,
    mi:Exp_5_P3_1_2 ,
    mi:Exp_5_P3_1_3 ;
  mi:isCategoryOf mi:Grade_5 .

mi:Cat_5_P3_3 a mi:StandardCategory ;
  mi:categoryCode "P3.3" ;
  skos:prefLabel "Persuasive Communication About a Public Issue" ;
  mi:categoryDescription "Communicate a reasoned position on a public issue." ;
  mi:inGrade mi:Grade_5 ;
  mi:inDiscipline mi:Discipline_P ;
  mi:hasExpectation
    mi:Exp_5_P3_3_1 ;
  mi:isCategoryOf mi:Grade_5 .

mi:Cat_5_P4_2 a mi:StandardCategory ;
  mi:categoryCode "P4.2" ;
  skos:prefLabel "Citizen Involvement" ;
  mi:categoryDescription "Act constructively to further the public good." ;
  mi:inGrade mi:Grade_5 ;
  mi:inDiscipline mi:Discipline_P ;
  mi:hasExpectation
    mi:Exp_5_P4_2_1 ,
    mi:Exp_5_P4_2_2 ;
  mi:isCategoryOf mi:Grade_5 .

mi:Cat_5_U1_1 a mi:StandardCategory ;
  mi:categoryCode "U1.1" ;
  skos:prefLabel "American Indian Life in the Americas" ;
  mi:categoryDescription "Describe the life of peoples living in North America before European exploration." ;
  mi:inGrade mi:Grade_5 ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExpectation
    mi:Exp_5_U1_1_1 ,
    mi:Exp_5_U1_1_2 ,
    mi:Exp_5_U1_1_3 ;
  mi:isCategoryOf mi:Grade_5 .

mi:Cat_5_U1_2 a mi:StandardCategory ;
  mi:categoryCode "U1.2" ;
  skos:prefLabel "European Exploration" ;
  mi:categoryDescription "Identify the causes and consequences of European exploration and colonization." ;
  mi:inGrade mi:Grade_5 ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExpectation
    mi:Exp_5_U1_2_1 ,
    mi:Exp_5_U1_2_2 ;
  mi:isCategoryOf mi:Grade_5 .

mi:Cat_5_U1_3 a mi:StandardCategory ;
  mi:categoryCode "U1.3" ;
  skos:prefLabel "African Life Before the 16th Century" ;
  mi:categoryDescription "Describe the lives of peoples living in western Africa prior to the 16th century." ;
  mi:inGrade mi:Grade_5 ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExpectation
    mi:Exp_5_U1_3_1 ,
    mi:Exp_5_U1_3_2 ;
  mi:isCategoryOf mi:Grade_5 .

mi:Cat_5_U1_4 a mi:StandardCategory ;
  mi:categoryCode "U1.4" ;
  skos:prefLabel "Three World Interactions" ;
  mi:categoryDescription "Describe the environmental, political, and cultural consequences of the interactions among European,African, and American Indian peoples in the late 15th through the 17th century." ;
  mi:inGrade mi:Grade_5 ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExpectation
    mi:Exp_5_U1_4_1 ,
    mi:Exp_5_U1_4_2 ,
    mi:Exp_5_U1_4_3 ,
    mi:Exp_5_U1_4_4 ;
  mi:isCategoryOf mi:Grade_5 .

mi:Cat_5_U2_1 a mi:StandardCategory ;
  mi:categoryCode "U2.1" ;
  skos:prefLabel "European Struggle for Control of North America" ;
  mi:categoryDescription "Compare the regional settlement patterns and describe significant developments in Southern, New England, and the mid-Atlantic colonies." ;
  mi:inGrade mi:Grade_5 ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExpectation
    mi:Exp_5_U2_1_1 ,
    mi:Exp_5_U2_1_2 ,
    mi:Exp_5_U2_1_3 ,
    mi:Exp_5_U2_1_4 ;
  mi:isCategoryOf mi:Grade_5 .

mi:Cat_5_U2_2 a mi:StandardCategory ;
  mi:categoryCode "U2.2" ;
  skos:prefLabel "European Slave Trade and Slavery in Colonial America" ;
  mi:categoryDescription "Analyze the development of the slave system in the Americas and its impact upon the life of Africans." ;
  mi:inGrade mi:Grade_5 ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExpectation
    mi:Exp_5_U2_2_1 ,
    mi:Exp_5_U2_2_2 ,
    mi:Exp_5_U2_2_3 ;
  mi:isCategoryOf mi:Grade_5 .

mi:Cat_5_U2_3 a mi:StandardCategory ;
  mi:categoryCode "U2.3" ;
  skos:prefLabel "Life in Colonial America" ;
  mi:categoryDescription "Distinguish among and explain the reasons for regional differences in colonial America." ;
  mi:inGrade mi:Grade_5 ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExpectation
    mi:Exp_5_U2_3_1 ,
    mi:Exp_5_U2_3_2 ,
    mi:Exp_5_U2_3_3 ,
    mi:Exp_5_U2_3_4 ,
    mi:Exp_5_U2_3_5 ;
  mi:isCategoryOf mi:Grade_5 .

mi:Cat_5_U3_1 a mi:StandardCategory ;
  mi:categoryCode "U3.1" ;
  skos:prefLabel "Causes of the American Revolution" ;
  mi:categoryDescription "Identify the major political, economic, and ideological reasons for the American Revolution." ;
  mi:inGrade mi:Grade_5 ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExpectation
    mi:Exp_5_U3_1_1 ,
    mi:Exp_5_U3_1_2 ,
    mi:Exp_5_U3_1_3 ,
    mi:Exp_5_U3_1_4 ,
    mi:Exp_5_U3_1_5 ,
    mi:Exp_5_U3_1_6 ,
