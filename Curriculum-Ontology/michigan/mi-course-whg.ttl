  mi:expectationCode "5.2.1" ;
  mi:fullCode "WHG-5.2.1" ;
  mi:officialText "Cultural Encounters and the Columbian Exchange - explain the demographic, environmental, and political consequences of European oceanic travel and conquest." ;
  skos:prefLabel "Cultural Encounters and the Columbian Exchange" ;
