  mi:categoryCode "7.1" ;
  skos:prefLabel "Power and Resistance, Global Conflict, Genocide in the 20th Century, and Technological," ;
  mi:categoryDescription "Scientific, and Cultural Exchanges Analyze the impact of changes in global balances of military, political, economic, and technological power throughout the 20th century and to the present." ;
  mi:inCourse mi:Course_WHG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:hasExpectation
