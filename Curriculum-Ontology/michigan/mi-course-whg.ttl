  mi:expectationCode "6.1.1" ;
  mi:fullCode "WHG-6.1.1" ;
  mi:officialText "Global Revolutions - explain the characteristics, extent, and impact of the global revolutions, including but not limited to changes in economic and political systems, and shifts in relative political and military power." ;
  skos:prefLabel "Global Revolutions" ;
