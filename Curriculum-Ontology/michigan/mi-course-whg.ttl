mi:Exp_WHG_5_2_2 a mi:Expectation ;
  mi:expectationCode "5.2.2" ;
  mi:fullCode "WHG-5.2.2" ;
  mi:officialText "The Trans-Atlantic Slave Trade - analyze the causes and development of the Atlantic trade system with respect to the capture and sale of Africans, the creation of the gun-slave cycle, the Middle Passage, and forced migration of Africans to the Americas, the establishment of the plantation complex, and the rise of slave resistance in the New World." ;
  skos:prefLabel "The Trans-Atlantic Slave Trade" ;
  skos:broader mi:Cat_WHG_5_2 ;
