#################################################################
# Categories
#################################################################
mi:Cat_WHG_4_1 a mi:StandardCategory ;
  mi:categoryCode "4.1" ;
  skos:prefLabel "Growth and Interactions of World Religions, and Intensifying Trade Networks and Contacts" ;
  mi:categoryDescription "Analyze important hemispheric interactions and temporal developments during an era of increasing regional power, religious expansion, and the collapse of some powerful empires." ;
  mi:inCourse mi:Course_WHG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:hasExpectation
    mi:Exp_WHG_4_1_1 ,
    mi:Exp_WHG_4_1_2 ;
  mi:isCategoryOf mi:Course_WHG .

mi:Cat_WHG_4_2 a mi:StandardCategory ;
  mi:categoryCode "4.2" ;
  skos:prefLabel "Growth of Islam and Dar al-Islam, Unification of Eurasia under the Mongols, and Spheres of" ;
  mi:categoryDescription "Interaction and Influence in the Americas WHG Era 5 - The Emergence of the First Global Age, 15th to 18th Centuries Analyze and compare important hemispheric interactions and cross-regional developments, including the growth and consequences of an interregional system of communication, trade, and culture exchange during an era of increasing regional power and religious expansion." ;
  mi:inCourse mi:Course_WHG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:hasExpectation
    mi:Exp_WHG_4_2_1 ,
    mi:Exp_WHG_4_2_2 ,
    mi:Exp_WHG_4_2_3 ;
  mi:isCategoryOf mi:Course_WHG .

mi:Cat_WHG_5_1 a mi:StandardCategory ;
  mi:categoryCode "5.1" ;
  skos:prefLabel "Emerging Global System and Diffusion of World Religions" ;
  mi:categoryDescription "Analyze the global impact of and significant developments caused by transoceanic travel and the linking of all the major areas of the world by the 18th century." ;
  mi:inCourse mi:Course_WHG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:hasExpectation
    mi:Exp_WHG_5_1_1 ,
    mi:Exp_WHG_5_1_2 ;
  mi:isCategoryOf mi:Course_WHG .

mi:Cat_WHG_5_2 a mi:StandardCategory ;
  mi:categoryCode "5.2" ;
  skos:prefLabel "Cultural Encounters and the Columbian Exchange, the Trans-Atlantic Slave Trade, and Afro-" ;
  mi:categoryDescription "Eurasian Empires WHG Era 6 - An Age of Global Revolutions, 18th Century-1914 Evaluate the impact of the global convergence on interregional developments and interactions in various contexts." ;
  mi:inCourse mi:Course_WHG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:hasExpectation
    mi:Exp_WHG_5_2_1 ,
    mi:Exp_WHG_5_2_2 ,
    mi:Exp_WHG_5_2_3 ;
  mi:isCategoryOf mi:Course_WHG .

mi:Cat_WHG_6_1 a mi:StandardCategory ;
  mi:categoryCode "6.1" ;
  skos:prefLabel "Global Revolutions, Worldwide Migrations and Population Changes, and Increasing Global" ;
  mi:categoryDescription "Interconnections Evaluate the causes, characteristics, and consequences of revolutions of the intellectual, political, and economic structures in an era of increasing global trade and consolidations of power." ;
  mi:inCourse mi:Course_WHG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:hasExpectation
    mi:Exp_WHG_6_1_1 ,
    mi:Exp_WHG_6_1_2 ,
    mi:Exp_WHG_6_1_3 ;
  mi:isCategoryOf mi:Course_WHG .

mi:Cat_WHG_6_2 a mi:StandardCategory ;
  mi:categoryCode "6.2" ;
  skos:prefLabel "Comparing Political Revolutions and/or Independence Movements, Growth of Nationalism and" ;
  mi:categoryDescription "Nation-States, Industrialization, and Imperialism WHG Era 7 - Global Crisis and Achievement, 1900-PRESENT DAY Analyze and compare the interregional patterns of nationalism, state building, social and economic reform, and imperialism." ;
  mi:inCourse mi:Course_WHG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:hasExpectation
    mi:Exp_WHG_6_2_1 ,
