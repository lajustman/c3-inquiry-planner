  mi:expectationCode "6.1.2" ;
  mi:fullCode "WHG-6.1.2" ;
  mi:officialText "Worldwide Migrations and Population Changes - analyze the causes and consequences of shifts in world population and major patterns of long-distance migrations, including the impact of industrialism, imperialism, changing diets, and scientific advances." ;
  skos:prefLabel "Worldwide Migrations and Population Changes" ;
