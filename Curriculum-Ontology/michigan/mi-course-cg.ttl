  mi:expectationCode "P1.1" ;
  mi:fullCode "CG-P1.1" ;
  mi:officialText "Use appropriate strategies to read and analyze social science tables, graphs, graphics, maps, and texts." ;
  skos:prefLabel "Appropriate Strategies to Read and Analyze Social Science Tables, Graphs, Graphics, Maps, and Texts" ;
