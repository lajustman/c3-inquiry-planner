#################################################################
# Expectations
#################################################################
mi:Exp_CG_CG1 a mi:Expectation ;
  mi:expectationCode "CG1" ;
  mi:fullCode "CG-CG1" ;
  mi:officialText "Population Explain the causes and consequences of contemporary population changes by analyzing the: • population change (including birth rate, death rate, life expectancy, growth rate, doubling time, aging population, changes in science and technology)." ;
  skos:prefLabel "Causes and Consequences of Contemporary Population Changes" ;
  skos:broader mi:Cat_CG_CG1 ;
  mi:inCategory mi:Cat_CG_CG1 ;
  mi:inCourse mi:Course_CG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:hasExample
    mi:Example_exp_CG_CG1_1 ,
    mi:Example_exp_CG_CG1_2 ;
  mi:isExpectationOf mi:Cat_CG_CG1 .

mi:Exp_CG_CG2 a mi:Expectation ;
  mi:expectationCode "CG2" ;
  mi:fullCode "CG-CG2" ;
  mi:officialText "Resources Explain changes in the use, distribution, and importance of natural resources (including land, water, energy, food; and renewable, non-renewable, and flow resources) on human life, settlement, and interactions by describing and evaluating: • changes in spatial distribution and use of natural resources." ;
  skos:prefLabel "Changes in the Use, Distribution, and Importance of Natural Resources on Human Life, Settlement, and..." ;
  skos:broader mi:Cat_CG_CG2 ;
  mi:inCategory mi:Cat_CG_CG2 ;
  mi:inCourse mi:Course_CG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:hasExample
    mi:Example_exp_CG_CG2_1 ,
    mi:Example_exp_CG_CG2_2 ,
    mi:Example_exp_CG_CG2_3 ,
    mi:Example_exp_CG_CG2_4 ;
  mi:isExpectationOf mi:Cat_CG_CG2 .

mi:Exp_CG_CG3 a mi:Expectation ;
  mi:expectationCode "CG3" ;
  mi:fullCode "CG-CG3" ;
  mi:officialText "Patterns of Global Interactions Define the process of globalization and evaluate the merit of this concept to describe the contemporary world by analyzing: • economic interdependence of the world's countries, world trade patterns, and the impact on those who labor, including voluntary and forced migration such as human trafficking." ;
  skos:prefLabel "Merit of This Concept to Describe the Contemporary World" ;
  skos:broader mi:Cat_CG_CG3 ;
  mi:inCategory mi:Cat_CG_CG3 ;
  mi:inCourse mi:Course_CG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:hasExample
    mi:Example_exp_CG_CG3_1 ,
    mi:Example_exp_CG_CG3_2 ,
    mi:Example_exp_CG_CG3_3 ,
    mi:Example_exp_CG_CG3_4 ;
  mi:isExpectationOf mi:Cat_CG_CG3 .

mi:Exp_CG_CG4 a mi:Expectation ;
  mi:expectationCode "CG4" ;
  mi:fullCode "CG-CG4" ;
  mi:officialText "Conflict, Cooperation, and Security Analyze the causes and challenges of continuing and new conflicts by describing: • tensions resulting from ethnic, territorial, religious, and/or nationalist differences." ;
  skos:prefLabel "Causes and Challenges of Continuing and New Conflicts" ;
  skos:broader mi:Cat_CG_CG4 ;
  mi:inCategory mi:Cat_CG_CG4 ;
  mi:inCourse mi:Course_CG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:hasExample
    mi:Example_exp_CG_CG4_1 ,
    mi:Example_exp_CG_CG4_2 ,
    mi:Example_exp_CG_CG4_3 ;
  mi:isExpectationOf mi:Cat_CG_CG4 .

