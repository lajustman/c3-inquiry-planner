mi:Exp_CG_P2_1 a mi:Expectation ;
  mi:expectationCode "P2.1" ;
  mi:fullCode "CG-P2.1" ;
  mi:officialText "Apply methods of inquiry, including asking and answering compelling and supporting questions, to investigate social science problems." ;
  skos:prefLabel "Methods of Inquiry" ;
  skos:broader mi:Cat_CG_P2 ;
  mi:inCategory mi:Cat_CG_P2 ;
  mi:inCourse mi:Course_CG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:isExpectationOf mi:Cat_CG_P2 .

mi:Exp_CG_P2_2 a mi:Expectation ;
  mi:expectationCode "P2.2" ;
  mi:fullCode "CG-P2.2" ;
  mi:officialText "Evaluate data presented in social science tables, graphs, graphics, maps, and texts for credibility, considering the origin, authority, structure, and context of the information." ;
  skos:prefLabel "Data Presented in Social Science Tables, Graphs, Graphics, Maps, and Texts for Credibility, Considering the..." ;
  skos:broader mi:Cat_CG_P2 ;
  mi:inCategory mi:Cat_CG_P2 ;
  mi:inCourse mi:Course_CG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:isExpectationOf mi:Cat_CG_P2 .

mi:Exp_CG_P2_3 a mi:Expectation ;
  mi:expectationCode "P2.3" ;
  mi:fullCode "CG-P2.3" ;
  mi:officialText "Know how to find, organize, evaluate, and interpret information from a variety of credible sources." ;
  skos:prefLabel "Evaluate, and Interpret Information from a Variety of Credible Sources" ;
  skos:broader mi:Cat_CG_P2 ;
  mi:inCategory mi:Cat_CG_P2 ;
  mi:inCourse mi:Course_CG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:isExpectationOf mi:Cat_CG_P2 .

mi:Exp_CG_P2_4 a mi:Expectation ;
  mi:expectationCode "P2.4" ;
  mi:fullCode "CG-P2.4" ;
  mi:officialText "Use relevant information from multiple credible sources representing a wide range of views, considering the origin, authority, structure, and context, to answer a compelling or supporting question." ;
  skos:prefLabel "Relevant Information from Multiple Credible Sources Representing a Wide Range of Views, Considering the Origin,..." ;
  skos:broader mi:Cat_CG_P2 ;
  mi:inCategory mi:Cat_CG_P2 ;
  mi:inCourse mi:Course_CG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:isExpectationOf mi:Cat_CG_P2 .

mi:Exp_CG_P3_1 a mi:Expectation ;
  mi:expectationCode "P3.1" ;
  mi:fullCode "CG-P3.1" ;
  mi:officialText "Clearly state an issue as a question of public policy, gather and interpret information about that issue, analyze various perspectives, and generate and evaluate possible alternative resolutions." ;
  skos:prefLabel "Information about That Issue, Analyze Various Perspectives, and Generate and Evaluate Possible Alternative Resolutions" ;
  skos:broader mi:Cat_CG_P3 ;
  mi:inCategory mi:Cat_CG_P3 ;
  mi:inCourse mi:Course_CG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:isExpectationOf mi:Cat_CG_P3 .

mi:Exp_CG_P3_2 a mi:Expectation ;
  mi:expectationCode "P3.2" ;
  mi:fullCode "CG-P3.2" ;
  mi:officialText "Discuss public policy issues, by clarifying positions, considering opposing views, and applying Democratic Values or Constitutional Principles to develop and refine claims." ;
  skos:prefLabel "Public Policy Issues" ;
  skos:broader mi:Cat_CG_P3 ;
  mi:inCategory mi:Cat_CG_P3 ;
  mi:inCourse mi:Course_CG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:isExpectationOf mi:Cat_CG_P3 .

mi:Exp_CG_P3_3 a mi:Expectation ;
  mi:expectationCode "P3.3" ;
  mi:fullCode "CG-P3.3" ;
  mi:officialText "Construct claims and refine counter-claims expressing and justifying decisions on public policy issues." ;
  skos:prefLabel "Claims and Refine Counter-Claims Expressing and Justifying Decisions on Public Policy Issues" ;
  skos:broader mi:Cat_CG_P3 ;
  mi:inCategory mi:Cat_CG_P3 ;
  mi:inCourse mi:Course_CG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:isExpectationOf mi:Cat_CG_P3 .

mi:Exp_CG_P3_4 a mi:Expectation ;
  mi:expectationCode "P3.4" ;
  mi:fullCode "CG-P3.4" ;
  mi:officialText "Critique the use of reasoning, sequence, and supporting details in creating a claim and the subsequent evidence used to support a claim for credibility." ;
  skos:prefLabel "Of Reasoning, Sequence, and Supporting Details in Creating a Claim and the Subsequent Evidence Used..." ;
  skos:broader mi:Cat_CG_P3 ;
  mi:inCategory mi:Cat_CG_P3 ;
  mi:inCourse mi:Course_CG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:isExpectationOf mi:Cat_CG_P3 .

mi:Exp_CG_P4_1 a mi:Expectation ;
  mi:expectationCode "P4.1" ;
  mi:fullCode "CG-P4.1" ;
  mi:officialText "Act within the rule of law and hold others to the same standard." ;
  skos:prefLabel "Act Within the Rule of Law and Hold Others to the Same Standard" ;
  skos:broader mi:Cat_CG_P4 ;
  mi:inCategory mi:Cat_CG_P4 ;
  mi:inCourse mi:Course_CG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:isExpectationOf mi:Cat_CG_P4 .

mi:Exp_CG_P4_2 a mi:Expectation ;
  mi:expectationCode "P4.2" ;
  mi:fullCode "CG-P4.2" ;
  mi:officialText "Assess options for individual and collective action to advance views on matters of public policy and address local, regional, or global problems." ;
  skos:prefLabel "Options for Individual and Collective Action to Advance Views on Matters of Public Policy and..." ;
  skos:broader mi:Cat_CG_P4 ;
  mi:inCategory mi:Cat_CG_P4 ;
  mi:inCourse mi:Course_CG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:isExpectationOf mi:Cat_CG_P4 .

mi:Exp_CG_P4_3 a mi:Expectation ;
  mi:expectationCode "P4.3" ;
  mi:fullCode "CG-P4.3" ;
  mi:officialText "Plan, conduct, and evaluate the effectiveness of activities intended to advance views on matters of public policy and to address local, regional, or global problems." ;
  skos:prefLabel "Effectiveness of Activities Intended to Advance Views on Matters of Public Policy and to Address..." ;
  skos:broader mi:Cat_CG_P4 ;
  mi:inCategory mi:Cat_CG_P4 ;
  mi:inCourse mi:Course_CG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:isExpectationOf mi:Cat_CG_P4 .

#################################################################
# Examples
#################################################################
mi:Example_exp_CG_CG1_1 a mi:Example ;
  skos:prefLabel "distributions of population (including relative changes in urban-rural populations gender age patterns of migration and population density)" ;
  mi:exampleText "distributions of population (including relative changes in urban-rural populations gender age patterns of migration and population density)" .

mi:Example_exp_CG_CG1_2 a mi:Example ;
  skos:prefLabel "relationship of the population changes to global interactions and their impact on different regions of the world" ;
  mi:exampleText "relationship of the population changes to global interactions and their impact on different regions of the world" .

mi:Example_exp_CG_CG2_1 a mi:Example ;
  skos:prefLabel "the differences in ways societies have been using and distributing natural resources" ;
  mi:exampleText "the differences in ways societies have been using and distributing natural resources" .

mi:Example_exp_CG_CG2_2 a mi:Example ;
  skos:prefLabel "social political economic and environmental consequences of the development distribution and use of natural resources" ;
  mi:exampleText "social political economic and environmental consequences of the development distribution and use of natural resources" .

mi:Example_exp_CG_CG2_3 a mi:Example ;
  skos:prefLabel "major changes in networks for the production distribution and consumption of natural resources including the growth of multinational corporations and governmental and non-governmental organizations" ;
  mi:exampleText "major changes in networks for the production distribution and consumption of natural resources including the growth of multinational corporations and governmental and non-governmental organizations" .

mi:Example_exp_CG_CG2_4 a mi:Example ;
  skos:prefLabel "the impact of humans on the global environment" ;
  mi:exampleText "the impact of humans on the global environment" .

mi:Example_exp_CG_CG3_1 a mi:Example ;
  skos:prefLabel "the exchanges of scientific technological and medical innovations" ;
  mi:exampleText "the exchanges of scientific technological and medical innovations" .

mi:Example_exp_CG_CG3_2 a mi:Example ;
  skos:prefLabel "cultural diffusion and the different ways cultures/societies respond to \"new\" cultural ideas" ;
  mi:exampleText "cultural diffusion and the different ways cultures/societies respond to \"new\" cultural ideas" .

mi:Example_exp_CG_CG3_3 a mi:Example ;
  skos:prefLabel "the comparative economic advantages and disadvantages of regions regarding cost of labor natural resources location and tradition" ;
  mi:exampleText "the comparative economic advantages and disadvantages of regions regarding cost of labor natural resources location and tradition" .

mi:Example_exp_CG_CG3_4 a mi:Example ;
  skos:prefLabel "distribution of wealth and resources and efforts to narrow the inequitable distribution of resources" ;
  mi:exampleText "distribution of wealth and resources and efforts to narrow the inequitable distribution of resources" .

mi:Example_exp_CG_CG4_1 a mi:Example ;
  skos:prefLabel "causes of and responses to ethnic cleansing/genocide/mass killing" ;
  mi:exampleText "causes of and responses to ethnic cleansing/genocide/mass killing" .

mi:Example_exp_CG_CG4_2 a mi:Example ;
  skos:prefLabel "local and global attempts at peacekeeping security democratization and administration of international justice and human rights" ;
  mi:exampleText "local and global attempts at peacekeeping security democratization and administration of international justice and human rights" .

mi:Example_exp_CG_CG4_3 a mi:Example ;
  skos:prefLabel "the types of warfare used in these conflicts including terrorism private militias and new technologies" ;
  mi:exampleText "the types of warfare used in these conflicts including terrorism private militias and new technologies" .
