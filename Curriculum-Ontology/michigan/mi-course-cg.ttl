  mi:expectationCode "P1.3" ;
  mi:fullCode "CG-P1.3" ;
  mi:officialText "Explain points of agreement and disagreement experts have about the interpretation of sources and the application of disciplinary concepts." ;
  skos:prefLabel "Points of Agreement and Disagreement Experts Have about the Interpretation of Sources and the Application..." ;
  skos:broader mi:Cat_CG_P1 ;
  mi:inCategory mi:Cat_CG_P1 ;
  mi:inCourse mi:Course_CG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:isExpectationOf mi:Cat_CG_P1 .

mi:Exp_CG_P1_4 a mi:Expectation ;
  mi:expectationCode "P1.4" ;
  mi:fullCode "CG-P1.4" ;
  mi:officialText "Express social science ideas clearly in written, spoken, and graphic forms." ;
  skos:prefLabel "Express Social Science Ideas Clearly in Written, Spoken, and Graphic Forms" ;
  skos:broader mi:Cat_CG_P1 ;
  mi:inCategory mi:Cat_CG_P1 ;
  mi:inCourse mi:Course_CG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:isExpectationOf mi:Cat_CG_P1 .

mi:Exp_CG_P1_5 a mi:Expectation ;
  mi:expectationCode "P1.5" ;
  mi:fullCode "CG-P1.5" ;
  mi:officialText "Construct and present an argument supported with evidence." ;
  skos:prefLabel "And Present an Argument Supported" ;
  skos:broader mi:Cat_CG_P1 ;
  mi:inCategory mi:Cat_CG_P1 ;
  mi:inCourse mi:Course_CG ;
  mi:inDiscipline mi:Discipline_W ;
