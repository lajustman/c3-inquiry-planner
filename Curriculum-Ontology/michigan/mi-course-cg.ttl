  mi:expectationCode "P1.2" ;
  mi:fullCode "CG-P1.2" ;
  mi:officialText "Interpret primary and secondary source documents for point of view, context, bias, and frame of reference or perspective." ;
  skos:prefLabel "Primary and Secondary Source Documents for Point of View, Context, Bias, and Frame of Reference..." ;
  skos:broader mi:Cat_CG_P1 ;
  mi:inCategory mi:Cat_CG_P1 ;
  mi:inCourse mi:Course_CG ;
  mi:inDiscipline mi:Discipline_W ;
  mi:isExpectationOf mi:Cat_CG_P1 .

