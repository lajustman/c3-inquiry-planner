  mi:isCategoryOf mi:Course_CIVICS .

mi:Cat_CIVICS_C5_2 a mi:StandardCategory ;
  mi:categoryCode "C5.2" ;
  skos:prefLabel "U.S. Role in International Institutions and Affairs" ;
