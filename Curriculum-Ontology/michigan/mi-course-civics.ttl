  mi:inDiscipline mi:Discipline_C ;
  mi:hasExpectation
    mi:Exp_CIVICS_C3_1_1 ,
    mi:Exp_CIVICS_C3_1_2 ,
    mi:Exp_CIVICS_C3_1_3 ,
    mi:Exp_CIVICS_C3_1_4 ,
    mi:Exp_CIVICS_C3_1_5 ,
    mi:Exp_CIVICS_C3_1_6 ,
    mi:Exp_CIVICS_C3_1_7 ;
