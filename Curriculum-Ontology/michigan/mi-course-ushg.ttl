mi:Exp_USHG_6_2_2 a mi:Expectation ;
  mi:expectationCode "6.2.2" ;
  mi:fullCode "USHG-6.2.2" ;
  mi:officialText "World War I - explain the causes of World War I, the reasons for American neutrality and eventual entry into the war, and America's role in shaping the course of the war." ;
  skos:prefLabel "World War I" ;
  skos:broader mi:Cat_USHG_6_2 ;
  mi:inCategory mi:Cat_USHG_6_2 ;
  mi:inCourse mi:Course_USHG ;
