#################################################################
# Categories
#################################################################
mi:Cat_USHG_6_1 a mi:StandardCategory ;
  mi:categoryCode "6.1" ;
  skos:prefLabel "Growth of an Industrial and Urban America (included in Grade 8; begins SS-HSCE)" ;
  mi:categoryDescription "Explain the causes and consequences - both positive and negative - of the Industrial Revolution and America's growth from a predominantly agricultural, commercial, and rural nation to a more industrial and urban nation between 1870 and 1930." ;
  mi:inCourse mi:Course_USHG ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExpectation
    mi:Exp_USHG_6_1_1 ,
    mi:Exp_USHG_6_1_2 ,
    mi:Exp_USHG_6_1_3 ,
    mi:Exp_USHG_6_1_4 ;
  mi:isCategoryOf mi:Course_USHG .

mi:Cat_USHG_6_2 a mi:StandardCategory ;
  mi:categoryCode "6.2" ;
  skos:prefLabel "Becoming a World Power" ;
  mi:categoryDescription "Describe and analyze the major changes - both positive and negative - in the role the United States played in world affairs after the Civil War, and explain the causes and consequences of this changing role." ;
  mi:inCourse mi:Course_USHG ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExpectation
    mi:Exp_USHG_6_2_1 ,
    mi:Exp_USHG_6_2_2 ,
    mi:Exp_USHG_6_2_3 ,
    mi:Exp_USHG_6_2_4 ;
  mi:isCategoryOf mi:Course_USHG .

mi:Cat_USHG_6_3 a mi:StandardCategory ;
  mi:categoryCode "6.3" ;
  skos:prefLabel "Progressive Era" ;
  mi:categoryDescription "USHG ERA 7 - THE GREAT DEPRESSION AND WORLD WAR II (1920-1945) Select and evaluate major public and social issues emerging from the changes in industrial, urban, and global America during this period; analyze the solutions or resolutions developed by America and their consequences (positive/negative - anticipated/unanticipated)." ;
  mi:inCourse mi:Course_USHG ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExpectation
    mi:Exp_USHG_6_3_1 ,
    mi:Exp_USHG_6_3_2 ,
    mi:Exp_USHG_6_3_3 ,
    mi:Exp_USHG_6_3_4 ;
  mi:isCategoryOf mi:Course_USHG .

mi:Cat_USHG_7_1 a mi:StandardCategory ;
  mi:categoryCode "7.1" ;
  skos:prefLabel "Growing Crisis of Industrial Capitalism and Responses" ;
  mi:categoryDescription "Evaluate the key events and decisions surrounding the causes and consequences of the global depression of the 1930s and World War II." ;
  mi:inCourse mi:Course_USHG ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExpectation
    mi:Exp_USHG_7_1_1 ,
    mi:Exp_USHG_7_1_2 ,
    mi:Exp_USHG_7_1_3 ;
  mi:isCategoryOf mi:Course_USHG .

mi:Cat_USHG_7_2 a mi:StandardCategory ;
  mi:categoryCode "7.2" ;
  skos:prefLabel "World War II" ;
  mi:categoryDescription "USHG ERA 8 - POST-WORLD WAR II UNITED STATES (1945-1989) Draw conclusions about the causes and the course of World War II, and the effects of the war on U.S." ;
  mi:inCourse mi:Course_USHG ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExample
    mi:Example_cat_USHG_7_2_1 ;
  mi:hasExpectation
    mi:Exp_USHG_7_2_1 ,
    mi:Exp_USHG_7_2_2 ,
    mi:Exp_USHG_7_2_3 ,
    mi:Exp_USHG_7_2_4 ;
  mi:isCategoryOf mi:Course_USHG .

mi:Cat_USHG_8_1 a mi:StandardCategory ;
  mi:categoryCode "8.1" ;
  skos:prefLabel "Cold War and the United States" ;
  mi:categoryDescription "Individually and collaboratively, students will engage in planned inquiries to investigate the social transformation of post-war United States, how the Cold War and conflicts in Korea and Vietnam influenced domestic and international politics, and how the struggle for racial and gender equality and the extension of civil liberties impacted the United States." ;
  mi:inCourse mi:Course_USHG ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExpectation
    mi:Exp_USHG_8_1_1 ,
    mi:Exp_USHG_8_1_2 ,
    mi:Exp_USHG_8_1_3 ;
  mi:isCategoryOf mi:Course_USHG .

mi:Cat_USHG_8_2 a mi:StandardCategory ;
  mi:categoryCode "8.2" ;
  skos:prefLabel "Domestic Changes and Policies" ;
  mi:categoryDescription "Investigate demographic changes, domestic policies, conflicts, and tensions in post-World War II America." ;
  mi:inCourse mi:Course_USHG ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExpectation
    mi:Exp_USHG_8_2_1 ,
