  mi:categoryCode "8.3" ;
  skos:prefLabel "Civil Rights in the Post-World War II Era" ;
  mi:categoryDescription "USHG ERA 9 - AMERICA IN A NEW GLOBAL AGE Examine and analyze the Civil Rights Movement using key events, people, and organizations." ;
  mi:inCourse mi:Course_USHG ;
  mi:inDiscipline mi:Discipline_U ;
