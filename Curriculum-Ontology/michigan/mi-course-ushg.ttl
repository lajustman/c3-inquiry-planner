  mi:officialText "Use relevant information from multiple credible sources representing a wide range of views considering the origin, authority, structure, and context to answer a compelling or supporting question." ;
  skos:prefLabel "Relevant Information from Multiple Credible Sources Representing a Wide Range of Views Considering the Origin,..." ;
  skos:broader mi:Cat_USHG_P2 ;
  mi:inCategory mi:Cat_USHG_P2 ;
  mi:inCourse mi:Course_USHG ;
  mi:inDiscipline mi:Discipline_U ;
  mi:isExpectationOf mi:Cat_USHG_P2 .

mi:Exp_USHG_P3_1 a mi:Expectation ;
  mi:expectationCode "P3.1" ;
  mi:fullCode "USHG-P3.1" ;
  mi:officialText "Clearly state an issue as a question of public policy, gather and interpret information about that issue, analyze various perspectives, and generate and evaluate possible alternative resolutions." ;
  skos:prefLabel "Information about That Issue, Analyze Various Perspectives, and Generate and Evaluate Possible Alternative Resolutions" ;
  skos:broader mi:Cat_USHG_P3 ;
  mi:inCategory mi:Cat_USHG_P3 ;
  mi:inCourse mi:Course_USHG ;
  mi:inDiscipline mi:Discipline_U ;
  mi:isExpectationOf mi:Cat_USHG_P3 .

mi:Exp_USHG_P3_2 a mi:Expectation ;
  mi:expectationCode "P3.2" ;
  mi:fullCode "USHG-P3.2" ;
  mi:officialText "Discuss public policy issues, by clarifying position, considering opposing views, and applying core values or Constitutional Principles to develop and refine claims." ;
  skos:prefLabel "Public Policy Issues" ;
  skos:broader mi:Cat_USHG_P3 ;
  mi:inCategory mi:Cat_USHG_P3 ;
  mi:inCourse mi:Course_USHG ;
  mi:inDiscipline mi:Discipline_U ;
  mi:isExpectationOf mi:Cat_USHG_P3 .

mi:Exp_USHG_P3_3 a mi:Expectation ;
  mi:expectationCode "P3.3" ;
  mi:fullCode "USHG-P3.3" ;
  mi:officialText "Construct claims and refine counter-claims that express and justify decisions on public policy issues." ;
  skos:prefLabel "Claims and Refine Counter-Claims That Express and Justify Decisions on Public Policy Issues" ;
  skos:broader mi:Cat_USHG_P3 ;
  mi:inCategory mi:Cat_USHG_P3 ;
  mi:inCourse mi:Course_USHG ;
  mi:inDiscipline mi:Discipline_U ;
  mi:isExpectationOf mi:Cat_USHG_P3 .

mi:Exp_USHG_P3_4 a mi:Expectation ;
  mi:expectationCode "P3.4" ;
  mi:fullCode "USHG-P3.4" ;
  mi:officialText "Critique the use of reasoning, sequence, and supporting details in creating a claim and the subsequent evidence used to support a claim for credibility." ;
  skos:prefLabel "Of Reasoning, Sequence, and Supporting Details in Creating a Claim and the Subsequent Evidence Used..." ;
  skos:broader mi:Cat_USHG_P3 ;
  mi:inCategory mi:Cat_USHG_P3 ;
  mi:inCourse mi:Course_USHG ;
  mi:inDiscipline mi:Discipline_U ;
  mi:isExpectationOf mi:Cat_USHG_P3 .

