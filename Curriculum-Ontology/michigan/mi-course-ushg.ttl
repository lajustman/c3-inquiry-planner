# Expectations
#################################################################
mi:Exp_USHG_6_1_1 a mi:Expectation ;
  mi:expectationCode "6.1.1" ;
  mi:fullCode "USHG-6.1.1" ;
  mi:officialText "Factors in the American Second Industrial Revolution - analyze the factors that enabled the United States to become a major industrial power, including: • the organizational revolution." ;
  skos:prefLabel "Factors in the American Second Industrial Revolution" ;
  skos:broader mi:Cat_USHG_6_1 ;
  mi:inCategory mi:Cat_USHG_6_1 ;
  mi:inCourse mi:Course_USHG ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExample
    mi:Example_exp_USHG_6_1_1_1 ,
    mi:Example_exp_USHG_6_1_1_2 ,
    mi:Example_exp_USHG_6_1_1_3 ,
    mi:Example_exp_USHG_6_1_1_4 ,
    mi:Example_exp_USHG_6_1_1_5 ,
    mi:Example_exp_USHG_6_1_1_6 ;
  mi:isExpectationOf mi:Cat_USHG_6_1 .

mi:Exp_USHG_6_1_2 a mi:Expectation ;
  mi:expectationCode "6.1.2" ;
  mi:fullCode "USHG-6.1.2" ;
  mi:officialText "Labor's Response to Industrial Growth - evaluate the different responses of labor to industrial change, including the development of organized labor and the growth of populism and the populist movement." ;
  skos:prefLabel "Labor's Response to Industrial Growth" ;
  skos:broader mi:Cat_USHG_6_1 ;
  mi:inCategory mi:Cat_USHG_6_1 ;
  mi:inCourse mi:Course_USHG ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExample
    mi:Example_exp_USHG_6_1_2_1 ,
    mi:Example_exp_USHG_6_1_2_2 ;
  mi:isExpectationOf mi:Cat_USHG_6_1 .

mi:Exp_USHG_6_1_3 a mi:Expectation ;
  mi:expectationCode "6.1.3" ;
  mi:fullCode "USHG-6.1.3" ;
  mi:officialText "Urbanization - explain the causes and consequences of urbanization, including: • the location and expansion of major urban centers and their link to industry and trade." ;
  skos:prefLabel "Urbanization" ;
  skos:broader mi:Cat_USHG_6_1 ;
  mi:inCategory mi:Cat_USHG_6_1 ;
  mi:inCourse mi:Course_USHG ;
