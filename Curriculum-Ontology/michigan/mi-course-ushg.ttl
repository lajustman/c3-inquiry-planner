  mi:expectationCode "7.1.3" ;
  mi:fullCode "USHG-7.1.3" ;
  mi:officialText "The New Deal Era - explain and evaluate President Franklin Roosevelt's policies and tactics during the New Deal era, including: • the changing role of the federal government's responsibilities to protect the environment, meet challenges of unemployment, and to address the needs of workers, farmers, Indigenous Peoples, the poor, and the elderly." ;
  skos:prefLabel "The New Deal Era" ;
  skos:broader mi:Cat_USHG_7_1 ;
  mi:inCategory mi:Cat_USHG_7_1 ;
