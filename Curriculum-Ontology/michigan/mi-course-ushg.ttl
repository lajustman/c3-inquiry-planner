  mi:expectationCode "6.2.4" ;
  mi:fullCode "USHG-6.2.4" ;
  mi:officialText "Wilson and His Opponents - explain how President Woodrow Wilson's \"Fourteen Points\" differed from proposals by others, including French and British leaders and domestic opponents, in the debate over: • the Treaty of Versailles." ;
  skos:prefLabel "Wilson and His Opponents" ;
  skos:broader mi:Cat_USHG_6_2 ;
