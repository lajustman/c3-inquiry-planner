  mi:expectationCode "6.2.3" ;
  mi:fullCode "USHG-6.2.3" ;
  mi:officialText "Domestic Impact of World War I - analyze the domestic impact of World War I on the growth of the government, the expansion of the economy, the restrictions on civil liberties, the expansion of women's suffrage, and on internal migration." ;
  skos:prefLabel "Domestic Impact of World War I" ;
  skos:broader mi:Cat_USHG_6_2 ;
