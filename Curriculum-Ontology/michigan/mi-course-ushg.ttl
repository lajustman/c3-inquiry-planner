    mi:Example_exp_USHG_6_1_3_3 ;
  mi:isExpectationOf mi:Cat_USHG_6_1 .

mi:Exp_USHG_6_1_4 a mi:Expectation ;
  mi:expectationCode "6.1.4" ;
  mi:fullCode "USHG-6.1.4" ;
  mi:officialText "Growth and Change - explain the social, political, economic, and cultural shifts taking place in the United States at the end of the 19th century and beginning of the 20th century, by: • describing the developing systems of transportation (canals and railroads, including the Transcontinental Railroad), and their impact on the economy and society." ;
  skos:prefLabel "Growth and Change" ;
  skos:broader mi:Cat_USHG_6_1 ;
  mi:inCategory mi:Cat_USHG_6_1 ;
  mi:inCourse mi:Course_USHG ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExample
    mi:Example_exp_USHG_6_1_4_1 ,
    mi:Example_exp_USHG_6_1_4_2 ,
    mi:Example_exp_USHG_6_1_4_3 ,
    mi:Example_exp_USHG_6_1_4_4 ;
  mi:isExpectationOf mi:Cat_USHG_6_1 .

