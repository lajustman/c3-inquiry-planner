<mi-grade-K.ttl> a owl:Ontology ;
  owl:versionIRI <urn:mi:ss:grade:K> ;
  rdfs:label "Michigan Social Studies GLCE - Kindergarten" ;
  dcterms:creator "Michigan Department of Education" ;
  dcterms:source "Michigan K-12 Social Studies Standards (Michigan Department of Education)" ;
  owl:imports <mi-base.ttl> .

mi:Grade_K a mi:Grade ;
  skos:prefLabel "Kindergarten" ;
  mi:hasCategory
    mi:Cat_K_C2 ,
    mi:Cat_K_C5 ,
    mi:Cat_K_E1 ,
    mi:Cat_K_G1 ,
    mi:Cat_K_G2 ,
    mi:Cat_K_G5 ,
    mi:Cat_K_H2 ,
    mi:Cat_K_P3_1 ,
    mi:Cat_K_P3_3 ,
    mi:Cat_K_P4_2 ;
  mi:isGradeOf mi:MichiganGLCEFramework ;
  mi:gradeCode "K" ;
  mi:gradeOrder 0 .

#################################################################
# Categories
#################################################################
mi:Cat_K_C2 a mi:StandardCategory ;
  mi:categoryCode "C2" ;
  skos:prefLabel "Values and Principles of American Democracy" ;
  mi:categoryDescription "Understand values and principles of American constitutional democracy." ;
  mi:inGrade mi:Grade_K ;
  mi:inDiscipline mi:Discipline_C ;
  mi:hasExpectation
    mi:Exp_K_C2_0_1 ,
    mi:Exp_K_C2_0_2 ,
    mi:Exp_K_C2_0_3 ;
  mi:isCategoryOf mi:Grade_K .

mi:Cat_K_C5 a mi:StandardCategory ;
  mi:categoryCode "C5" ;
  skos:prefLabel "Role of the Citizen in American Democracy" ;
  mi:categoryDescription "Explain important rights and how, when, and where American citizens demonstrate their responsibilities by participating in government." ;
  mi:inGrade mi:Grade_K ;
  mi:inDiscipline mi:Discipline_C ;
  mi:hasExpectation
    mi:Exp_K_C5_0_1 ;
  mi:isCategoryOf mi:Grade_K .

mi:Cat_K_E1 a mi:StandardCategory ;
  mi:categoryCode "E1" ;
  skos:prefLabel "Market Economy" ;
  mi:categoryDescription "Use fundamental principles and concepts of economics to understand economic activity in a market economy." ;
  mi:inGrade mi:Grade_K ;
  mi:inDiscipline mi:Discipline_E ;
  mi:hasExpectation
    mi:Exp_K_E1_0_1 ,
    mi:Exp_K_E1_0_2 ,
    mi:Exp_K_E1_0_3 ;
  mi:isCategoryOf mi:Grade_K .

mi:Cat_K_G1 a mi:StandardCategory ;
  mi:categoryCode "G1" ;
  skos:prefLabel "The World in Spatial Terms" ;
  mi:categoryDescription "Use geographic representations to acquire, process, and report information from a spatial perspective." ;
  mi:inGrade mi:Grade_K ;
  mi:inDiscipline mi:Discipline_G ;
  mi:hasExpectation
    mi:Exp_K_G1_0_1 ,
    mi:Exp_K_G1_0_2 ;
  mi:isCategoryOf mi:Grade_K .

mi:Cat_K_G2 a mi:StandardCategory ;
  mi:categoryCode "G2" ;
  skos:prefLabel "Places and Regions" ;
  mi:categoryDescription "Understand how regions are created from common physical and human characteristics." ;
  mi:inGrade mi:Grade_K ;
  mi:inDiscipline mi:Discipline_G ;
  mi:hasExpectation
    mi:Exp_K_G2_0_1 ;
  mi:isCategoryOf mi:Grade_K .

mi:Cat_K_G5 a mi:StandardCategory ;
  mi:categoryCode "G5" ;
  skos:prefLabel "Environment and Society" ;
  mi:categoryDescription "Understand the effects of human-environment interactions." ;
  mi:inGrade mi:Grade_K ;
  mi:inDiscipline mi:Discipline_G ;
  mi:hasExpectation
    mi:Exp_K_G5_0_1 ;
  mi:isCategoryOf mi:Grade_K .

mi:Cat_K_H2 a mi:StandardCategory ;
  mi:categoryCode "H2" ;
  skos:prefLabel "Living and Working Together" ;
  mi:categoryDescription "Use historical thinking to understand the past." ;
  mi:inGrade mi:Grade_K ;
  mi:inDiscipline mi:Discipline_H ;
  mi:hasExpectation
    mi:Exp_K_H2_0_1 ,
    mi:Exp_K_H2_0_2 ,
    mi:Exp_K_H2_0_3 ,
    mi:Exp_K_H2_0_4 ;
  mi:isCategoryOf mi:Grade_K .

mi:Cat_K_P3_1 a mi:StandardCategory ;
  mi:categoryCode "P3.1" ;
  skos:prefLabel "Identifying and Analyzing Public Issues" ;
  mi:categoryDescription "Clearly state a problem as a public policy issue, analyze various perspectives, and generate and evaluate possible alternative resolutions." ;
  mi:inGrade mi:Grade_K ;
  mi:inDiscipline mi:Discipline_P ;
  mi:hasExpectation
    mi:Exp_K_P3_1_1 ,
    mi:Exp_K_P3_1_2 ,
    mi:Exp_K_P3_1_3 ;
  mi:isCategoryOf mi:Grade_K .

mi:Cat_K_P3_3 a mi:StandardCategory ;
  mi:categoryCode "P3.3" ;
  skos:prefLabel "Persuasive Communication About a Public Issue" ;
  mi:categoryDescription "Communicate a reasoned position on a public issue." ;
  mi:inGrade mi:Grade_K ;
  mi:inDiscipline mi:Discipline_P ;
  mi:hasExpectation
    mi:Exp_K_P3_3_1 ;
  mi:isCategoryOf mi:Grade_K .

mi:Cat_K_P4_2 a mi:StandardCategory ;
  mi:categoryCode "P4.2" ;
  skos:prefLabel "Citizen Involvement" ;
  mi:categoryDescription "Act constructively to further the public good." ;
  mi:inGrade mi:Grade_K ;
  mi:inDiscipline mi:Discipline_P ;
  mi:hasExpectation
    mi:Exp_K_P4_2_1 ,
    mi:Exp_K_P4_2_2 ;
  mi:isCategoryOf mi:Grade_K .

