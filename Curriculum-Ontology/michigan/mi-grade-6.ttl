mi:Exp_6_E2_3_1 a mi:Expectation ;
  mi:expectationCode "E2.3.1" ;
  mi:fullCode "6-E2.3.1" ;
  mi:officialText "Describe the impact of governmental policy (sanctions, tariffs, treaties) on that country and on other countries that use its resources." ;
  skos:prefLabel "Impact of Governmental Policy on That Country and on Other Countries That Use Its Resources" ;
  skos:broader mi:Cat_6_E2_3 ;
  mi:inCategory mi:Cat_6_E2_3 ;
  mi:inGrade mi:Grade_6 ;
  mi:inDiscipline mi:Discipline_E ;
  mi:isExpectationOf mi:Cat_6_E2_3 .

mi:Exp_6_E3_1_1 a mi:Expectation ;
  mi:expectationCode "E3.1.1" ;
  mi:fullCode "6-E3.1.1" ;
  mi:officialText "Use charts and graphs to compare imports and exports of different countries in the Western Hemisphere and propose generalizations about patterns of economic interdependence." ;
  skos:prefLabel "Charts and Graphs to Compare Imports and Exports of Different Countries in the Western Hemisphere..." ;
  skos:broader mi:Cat_6_E3_1 ;
  mi:inCategory mi:Cat_6_E3_1 ;
  mi:inGrade mi:Grade_6 ;
  mi:inDiscipline mi:Discipline_E ;
  mi:isExpectationOf mi:Cat_6_E3_1 .

mi:Exp_6_E3_1_2 a mi:Expectation ;
  mi:expectationCode "E3.1.2" ;
  mi:fullCode "6-E3.1.2" ;
