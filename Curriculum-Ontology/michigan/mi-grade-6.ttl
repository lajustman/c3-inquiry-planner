# Categories
#################################################################
mi:Cat_6_C1_1 a mi:StandardCategory ;
  mi:categoryCode "C1.1" ;
  skos:prefLabel "Nature of Civic Life, Politics, and Government" ;
  mi:categoryDescription "Describe Civic Life, Politics, and Government and explain their relationships." ;
  mi:inGrade mi:Grade_6 ;
  mi:inDiscipline mi:Discipline_C ;
  mi:hasExpectation
    mi:Exp_6_C1_1_1 ;
  mi:isCategoryOf mi:Grade_6 .

mi:Cat_6_C3_6 a mi:StandardCategory ;
  mi:categoryCode "C3.6" ;
  skos:prefLabel "Characteristics of Nation-States" ;
  mi:categoryDescription "Describe the characteristics of nation-states and how they may interact." ;
  mi:inGrade mi:Grade_6 ;
  mi:inDiscipline mi:Discipline_C ;
  mi:hasExpectation
    mi:Exp_6_C3_6_1 ,
    mi:Exp_6_C3_6_2 ;
  mi:isCategoryOf mi:Grade_6 .

mi:Cat_6_C4_3 a mi:StandardCategory ;
  mi:categoryCode "C4.3" ;
  skos:prefLabel "Conflict and Cooperation Between and Among Nations" ;
  mi:categoryDescription "Explain the various ways that nations interact both positively and negatively." ;
  mi:inGrade mi:Grade_6 ;
  mi:inDiscipline mi:Discipline_C ;
  mi:hasExpectation
    mi:Exp_6_C4_3_1 ,
    mi:Exp_6_C4_3_2 ,
    mi:Exp_6_C4_3_3 ;
  mi:isCategoryOf mi:Grade_6 .

mi:Cat_6_E1_1 a mi:StandardCategory ;
  mi:categoryCode "E1.1" ;
  skos:prefLabel "Individual, Business, and Government Choices" ;
  mi:categoryDescription "Describe how individuals, businesses and government make economic decisions when confronting scarcity in the market economy ." ;
  mi:inGrade mi:Grade_6 ;
  mi:inDiscipline mi:Discipline_E ;
  mi:hasExpectation
    mi:Exp_6_E1_1_1 ;
  mi:isCategoryOf mi:Grade_6 .

mi:Cat_6_E2_3 a mi:StandardCategory ;
  mi:categoryCode "E2.3" ;
  skos:prefLabel "Role of Government" ;
  mi:categoryDescription "Describe how national governments make decisions that affect the national economy" ;
  mi:inGrade mi:Grade_6 ;
  mi:inDiscipline mi:Discipline_E ;
  mi:hasExpectation
    mi:Exp_6_E2_3_1 ;
  mi:isCategoryOf mi:Grade_6 .

mi:Cat_6_E3_1 a mi:StandardCategory ;
  mi:categoryCode "E3.1" ;
