#################################################################
# Expectations
#################################################################
mi:Exp_6_C1_1_1 a mi:Expectation ;
  mi:expectationCode "C1.1.1" ;
  mi:fullCode "6-C1.1.1" ;
  mi:officialText "Analyze competing ideas about the purposes government should serve in a democracy and in a dictatorship." ;
  skos:prefLabel "Competing Ideas about the Purposes Government Should Serve in a Democracy and in a Dictatorship" ;
  skos:broader mi:Cat_6_C1_1 ;
  mi:inCategory mi:Cat_6_C1_1 ;
  mi:inGrade mi:Grade_6 ;
  mi:inDiscipline mi:Discipline_C ;
  mi:hasExample
    mi:Example_exp_6_C1_1_1_1 ,
    mi:Example_exp_6_C1_1_1_2 ,
    mi:Example_exp_6_C1_1_1_3 ,
    mi:Example_exp_6_C1_1_1_4 ,
    mi:Example_exp_6_C1_1_1_5 ;
  mi:isExpectationOf mi:Cat_6_C1_1 .

mi:Exp_6_C3_6_1 a mi:Expectation ;
  mi:expectationCode "C3.6.1" ;
  mi:fullCode "6-C3.6.1" ;
  mi:officialText "Define the characteristics of a nation-state (a specific territory, clearly defined boundaries, citizens, and jurisdiction over people who reside there, laws, and government), and how Western Hemisphere nations interact." ;
  skos:prefLabel "Define the Characteristics of a Nation-State" ;
  skos:broader mi:Cat_6_C3_6 ;
  mi:inCategory mi:Cat_6_C3_6 ;
  mi:inGrade mi:Grade_6 ;
  mi:inDiscipline mi:Discipline_C ;
  mi:isExpectationOf mi:Cat_6_C3_6 .

mi:Exp_6_C3_6_2 a mi:Expectation ;
  mi:expectationCode "C3.6.2" ;
  mi:fullCode "6-C3.6.2" ;
  mi:officialText "Compare and contrast a military dictatorship such as Cuba, a presidential system of representative democracy such as the United States, and a parliamentary system of representative democracy such as Canada." ;
  skos:prefLabel "A Military Dictatorship" ;
  skos:broader mi:Cat_6_C3_6 ;
  mi:inCategory mi:Cat_6_C3_6 ;
  mi:inGrade mi:Grade_6 ;
  mi:inDiscipline mi:Discipline_C ;
  mi:isExpectationOf mi:Cat_6_C3_6 .

mi:Exp_6_C4_3_1 a mi:Expectation ;
  mi:expectationCode "C4.3.1" ;
  mi:fullCode "6-C4.3.1" ;
  mi:officialText "Explain the geopolitical relationships between countries." ;
  skos:prefLabel "Geopolitical Relationships between Countries" ;
  skos:broader mi:Cat_6_C4_3 ;
  mi:inCategory mi:Cat_6_C4_3 ;
  mi:inGrade mi:Grade_6 ;
  mi:inDiscipline mi:Discipline_C ;
  mi:hasExample
    mi:Example_exp_6_C4_3_1_1 ,
    mi:Example_exp_6_C4_3_1_2 ;
  mi:isExpectationOf mi:Cat_6_C4_3 .

mi:Exp_6_C4_3_2 a mi:Expectation ;
  mi:expectationCode "C4.3.2" ;
  mi:fullCode "6-C4.3.2" ;
  mi:officialText "Explain the challenges to governments and the cooperation needed to address international issues in the Western Hemisphere." ;
  skos:prefLabel "Challenges to Governments and the Cooperation Needed to Address International Issues in the Western Hemisphere" ;
  skos:broader mi:Cat_6_C4_3 ;
  mi:inCategory mi:Cat_6_C4_3 ;
  mi:inGrade mi:Grade_6 ;
  mi:inDiscipline mi:Discipline_C ;
  mi:hasExample
    mi:Example_exp_6_C4_3_2_1 ;
  mi:isExpectationOf mi:Cat_6_C4_3 .

mi:Exp_6_C4_3_3 a mi:Expectation ;
  mi:expectationCode "C4.3.3" ;
  mi:fullCode "6-C4.3.3" ;
  mi:officialText "Give examples of how countries work together for mutual benefits through international organizations" ;
  skos:prefLabel "Give Examples of How Countries Work Together for Mutual Benefits" ;
  skos:broader mi:Cat_6_C4_3 ;
  mi:inCategory mi:Cat_6_C4_3 ;
  mi:inGrade mi:Grade_6 ;
  mi:inDiscipline mi:Discipline_C ;
  mi:hasExample
    mi:Example_exp_6_C4_3_3_1 ,
    mi:Example_exp_6_C4_3_3_2 ,
    mi:Example_exp_6_C4_3_3_3 ;
  mi:isExpectationOf mi:Cat_6_C4_3 .

mi:Exp_6_E1_1_1 a mi:Expectation ;
  mi:expectationCode "E1.1.1" ;
  mi:fullCode "6-E1.1.1" ;
  mi:officialText "Explain how incentives vary in different economic systems" ;
  skos:prefLabel "Incentives Vary in Different Economic Systems E.g" ;
  skos:broader mi:Cat_6_E1_1 ;
  mi:inCategory mi:Cat_6_E1_1 ;
  mi:inGrade mi:Grade_6 ;
  mi:inDiscipline mi:Discipline_E ;
  mi:hasExample
