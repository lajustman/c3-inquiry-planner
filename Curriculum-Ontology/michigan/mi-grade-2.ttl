#################################################################
# Categories
#################################################################
mi:Cat_2_C1 a mi:StandardCategory ;
  mi:categoryCode "C1" ;
  skos:prefLabel "Purposes of Government" ;
  mi:categoryDescription "Explain why people create governments." ;
  mi:inGrade mi:Grade_2 ;
  mi:inDiscipline mi:Discipline_C ;
  mi:hasExpectation
    mi:Exp_2_C1_0_1 ,
    mi:Exp_2_C1_0_2 ;
  mi:isCategoryOf mi:Grade_2 .

mi:Cat_2_C2 a mi:StandardCategory ;
  mi:categoryCode "C2" ;
  skos:prefLabel "Values and Principles of American Democracy" ;
  mi:categoryDescription "Understand values and principles of American constitutional democracy." ;
  mi:inGrade mi:Grade_2 ;
  mi:inDiscipline mi:Discipline_C ;
  mi:hasExpectation
    mi:Exp_2_C2_0_1 ,
    mi:Exp_2_C2_0_2 ;
  mi:isCategoryOf mi:Grade_2 .

mi:Cat_2_C3 a mi:StandardCategory ;
  mi:categoryCode "C3" ;
  skos:prefLabel "Structure and Functions of Government" ;
  mi:categoryDescription "Describe the structure of government in the United States and how it functions to serve citizens." ;
  mi:inGrade mi:Grade_2 ;
  mi:inDiscipline mi:Discipline_C ;
  mi:hasExpectation
    mi:Exp_2_C3_0_1 ,
    mi:Exp_2_C3_0_2 ,
    mi:Exp_2_C3_0_3 ;
  mi:isCategoryOf mi:Grade_2 .

mi:Cat_2_C5 a mi:StandardCategory ;
  mi:categoryCode "C5" ;
  skos:prefLabel "Roles of the Citizen in American Democracy" ;
  mi:categoryDescription "Explain important rights and how, when, and where American citizens demonstrate their responsibilities by participating in government." ;
  mi:inGrade mi:Grade_2 ;
  mi:inDiscipline mi:Discipline_C ;
  mi:hasExpectation
    mi:Exp_2_C5_0_1 ,
    mi:Exp_2_C5_0_2 ,
    mi:Exp_2_C5_0_3 ;
  mi:isCategoryOf mi:Grade_2 .

mi:Cat_2_E1 a mi:StandardCategory ;
  mi:categoryCode "E1" ;
  skos:prefLabel "Market Economy" ;
  mi:categoryDescription "Use fundamental principles and concepts of economics to understand economic activity in a market economy." ;
