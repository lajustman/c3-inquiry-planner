  mi:isExpectationOf mi:Cat_2_H2 .

mi:Exp_2_H2_0_5 a mi:Expectation ;
  mi:expectationCode "H2.0.5" ;
  mi:fullCode "2-H2.0.5" ;
  mi:officialText "Identify a problem in a community's past and describe how it was resolved." ;
  skos:prefLabel "A Problem in a Community's Past and Describe How It Was Resolved" ;
  skos:broader mi:Cat_2_H2 ;
  mi:inCategory mi:Cat_2_H2 ;
  mi:inGrade mi:Grade_2 ;
  mi:inDiscipline mi:Discipline_H ;
  mi:isExpectationOf mi:Cat_2_H2 .

mi:Exp_2_H2_0_6 a mi:Expectation ;
  mi:expectationCode "H2.0.6" ;
  mi:fullCode "2-H2.0.6" ;
  mi:officialText "Construct a historical narrative about the history of the local community from a variety of sources." ;
  skos:prefLabel "A Historical Narrative about the History of the Local Community from a Variety of Sources" ;
  skos:broader mi:Cat_2_H2 ;
  mi:inCategory mi:Cat_2_H2 ;
  mi:inGrade mi:Grade_2 ;
  mi:inDiscipline mi:Discipline_H ;
  mi:hasExample
    mi:Example_exp_2_H2_0_6_1 ,
    mi:Example_exp_2_H2_0_6_2 ,
    mi:Example_exp_2_H2_0_6_3 ;
  mi:isExpectationOf mi:Cat_2_H2 .

mi:Exp_2_P3_1_1 a mi:Expectation ;
  mi:expectationCode "P3.1.1" ;
  mi:fullCode "2-P3.1.1" ;
  mi:officialText "Identify public issues in the local community that influence the daily lives of its citizens." ;
  skos:prefLabel "Public Issues in the Local Community That Influence the Daily Lives of Its Citizens" ;
  skos:broader mi:Cat_2_P3_1 ;
  mi:inCategory mi:Cat_2_P3_1 ;
  mi:inGrade mi:Grade_2 ;
  mi:inDiscipline mi:Discipline_P ;
  mi:isExpectationOf mi:Cat_2_P3_1 .

mi:Exp_2_P3_1_2 a mi:Expectation ;
  mi:expectationCode "P3.1.2" ;
  mi:fullCode "2-P3.1.2" ;
  mi:officialText "Use graphic data and other sources to analyze information about a public issue in the local community and evaluate alternative resolutions." ;
  skos:prefLabel "Graphic Data and Other Sources to Analyze Information about a Public Issue in the Local..." ;
  skos:broader mi:Cat_2_P3_1 ;
  mi:inCategory mi:Cat_2_P3_1 ;
  mi:inGrade mi:Grade_2 ;
  mi:inDiscipline mi:Discipline_P ;
  mi:isExpectationOf mi:Cat_2_P3_1 .

mi:Exp_2_P3_1_3 a mi:Expectation ;
  mi:expectationCode "P3.1.3" ;
  mi:fullCode "2-P3.1.3" ;
  mi:officialText "Give examples of how conflicts over core democratic values lead people to differ on resolutions to a public policy issue in the local community." ;
  skos:prefLabel "Give Examples of How Conflicts over Core Democratic Values Lead People to Differ on Resolutions..." ;
  skos:broader mi:Cat_2_P3_1 ;
  mi:inCategory mi:Cat_2_P3_1 ;
  mi:inGrade mi:Grade_2 ;
  mi:inDiscipline mi:Discipline_P ;
  mi:isExpectationOf mi:Cat_2_P3_1 .

mi:Exp_2_P3_3_1 a mi:Expectation ;
  mi:expectationCode "P3.3.1" ;
  mi:fullCode "2-P3.3.1" ;
  mi:officialText "Compose a statement expressing a position on a public policy issue in the local community and justify the position with a reasoned argument." ;
  skos:prefLabel "Compose a Statement Expressing a Position on a Public Policy Issue in the Local Community..." ;
  skos:broader mi:Cat_2_P3_3 ;
  mi:inCategory mi:Cat_2_P3_3 ;
  mi:inGrade mi:Grade_2 ;
  mi:inDiscipline mi:Discipline_P ;
  mi:isExpectationOf mi:Cat_2_P3_3 .

mi:Exp_2_P4_2_1 a mi:Expectation ;
  mi:expectationCode "P4.2.1" ;
  mi:fullCode "2-P4.2.1" ;
  mi:officialText "Develop and implement an action plan to address or inform others about a public issue." ;
  skos:prefLabel "And Implement an Action Plan to Address or Inform Others about a Public Issue" ;
  skos:broader mi:Cat_2_P4_2 ;
  mi:inCategory mi:Cat_2_P4_2 ;
  mi:inGrade mi:Grade_2 ;
  mi:inDiscipline mi:Discipline_P ;
  mi:isExpectationOf mi:Cat_2_P4_2 .

mi:Exp_2_P4_2_2 a mi:Expectation ;
  mi:expectationCode "P4.2.2" ;
  mi:fullCode "2-P4.2.2" ;
  mi:officialText "Participate in projects to help or inform others." ;
  skos:prefLabel "Participate in Projects to Help or Inform Others" ;
  skos:broader mi:Cat_2_P4_2 ;
  mi:inCategory mi:Cat_2_P4_2 ;
  mi:inGrade mi:Grade_2 ;
  mi:inDiscipline mi:Discipline_P ;
  mi:isExpectationOf mi:Cat_2_P4_2 .

