mi:Cat_8_U4_2 a mi:StandardCategory ;
  mi:categoryCode "U4.2" ;
  skos:prefLabel "Regional and Economic Growth" ;
  mi:categoryDescription "Describe and analyze the nature and impact of the territorial, demographic, and economic growth in the first three decades of the new nation using maps, charts, and other evidence." ;
  mi:inGrade mi:Grade_8 ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExpectation
    mi:Exp_8_U4_2_1 ,
