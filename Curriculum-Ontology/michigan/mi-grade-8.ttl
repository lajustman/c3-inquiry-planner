  mi:categoryCode "U6.2" ;
  skos:prefLabel "Investigation Topics and Issue Analysis (P2)" ;
  mi:categoryDescription "Use the historical perspective to investigate a significant historical topic from United States History Eras 3-6 that also has significance as an issue or topic in the United States today." ;
  mi:inGrade mi:Grade_8 ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExpectation
    mi:Exp_8_U6_2_1 ;
  mi:isCategoryOf mi:Grade_8 .

