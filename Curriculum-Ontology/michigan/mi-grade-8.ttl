    mi:Exp_8_U3_3_6 ,
    mi:Exp_8_U3_3_7 ;
  mi:isCategoryOf mi:Grade_8 .

mi:Cat_8_U4_1 a mi:StandardCategory ;
  mi:categoryCode "U4.1" ;
  skos:prefLabel "Challenges to an Emerging Nation" ;
  mi:categoryDescription "Analyze the challenges the new government faced and the role of political and social leaders in meeting these challenges." ;
  mi:inGrade mi:Grade_8 ;
