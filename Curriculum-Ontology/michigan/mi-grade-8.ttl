#################################################################
# Categories
#################################################################
mi:Cat_8_P3_1 a mi:StandardCategory ;
  mi:categoryCode "P3.1" ;
  skos:prefLabel "Identifying and Analyzing Issues, Decision Making, Persuasive Communication About a Public Issue, and Citizen Involvement" ;
  mi:inGrade mi:Grade_8 ;
  mi:inDiscipline mi:Discipline_P ;
  mi:hasExpectation
    mi:Exp_8_P3_1_1 ;
  mi:isCategoryOf mi:Grade_8 .

mi:Cat_8_P4_2 a mi:StandardCategory ;
  mi:categoryCode "P4.2" ;
  skos:prefLabel "Citizen Involvement" ;
  mi:categoryDescription "Act constructively to further the public good." ;
  mi:inGrade mi:Grade_8 ;
  mi:inDiscipline mi:Discipline_P ;
  mi:hasExpectation
    mi:Exp_8_P4_2_1 ,
    mi:Exp_8_P4_2_2 ,
    mi:Exp_8_P4_2_3 ;
  mi:isCategoryOf mi:Grade_8 .

mi:Cat_8_U3_3 a mi:StandardCategory ;
  mi:categoryCode "U3.3" ;
  skos:prefLabel "Creating New Government(s) and a New Constitution" ;
  mi:categoryDescription "Explain the challenges faced by the new nation and analyze the development of the Constitution as a new plan for governing." ;
  mi:inGrade mi:Grade_8 ;
  mi:inDiscipline mi:Discipline_U ;
  mi:hasExpectation
    mi:Exp_8_U3_3_1 ,
    mi:Exp_8_U3_3_2 ,
