mi:Cat_8_U6_1 a mi:StandardCategory ;
  mi:categoryCode "U6.1" ;
  skos:prefLabel "America in the Last Half of the 19th Century" ;
  mi:categoryDescription "Analyze the major changes in communication, transportation, demography, and urban centers, including the location and growth of cities linked by industry and trade, in last half of the 19th century." ;
  mi:inGrade mi:Grade_8 ;
  mi:inDiscipline mi:Discipline_U ;
