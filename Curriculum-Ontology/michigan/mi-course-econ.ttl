#################################################################
# Expectations
#################################################################
mi:Exp_ECON_1_1_1 a mi:Expectation ;
  mi:expectationCode "1.1.1" ;
  mi:fullCode "ECON-1.1.1" ;
  mi:officialText "Scarcity, Choice, Opportunity Costs, Incentives - using examples, explain how scarcity, choice, opportunity costs, and incentives affect decisions made by households, businesses, and governments." ;
  skos:prefLabel "Scarcity, Choice, Opportunity Costs, Incentives" ;
  skos:broader mi:Cat_ECON_1_1 ;
  mi:inCategory mi:Cat_ECON_1_1 ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:isExpectationOf mi:Cat_ECON_1_1 .

mi:Exp_ECON_1_1_2 a mi:Expectation ;
  mi:expectationCode "1.1.2" ;
  mi:fullCode "ECON-1.1.2" ;
  mi:officialText "Entrepreneurship - analyze the risks and rewards of entrepreneurship and associate the functions of entrepreneurs with alleviating problems associated with scarcity." ;
  skos:prefLabel "Entrepreneurship" ;
  skos:broader mi:Cat_ECON_1_1 ;
  mi:inCategory mi:Cat_ECON_1_1 ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:isExpectationOf mi:Cat_ECON_1_1 .

mi:Exp_ECON_1_1_3 a mi:Expectation ;
  mi:expectationCode "1.1.3" ;
  mi:fullCode "ECON-1.1.3" ;
  mi:officialText "Marginal Analysis - weigh marginal benefits and marginal costs in decision making." ;
  skos:prefLabel "Marginal Analysis" ;
  skos:broader mi:Cat_ECON_1_1 ;
  mi:inCategory mi:Cat_ECON_1_1 ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:isExpectationOf mi:Cat_ECON_1_1 .

mi:Exp_ECON_1_2_1 a mi:Expectation ;
  mi:expectationCode "1.2.1" ;
  mi:fullCode "ECON-1.2.1" ;
  mi:officialText "Institutions - describe the roles of various economic institutions and purposes they serve in a market economy." ;
  skos:prefLabel "Institutions" ;
  skos:broader mi:Cat_ECON_1_2 ;
  mi:inCategory mi:Cat_ECON_1_2 ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:hasExample
    mi:Example_exp_ECON_1_2_1_1 ;
  mi:isExpectationOf mi:Cat_ECON_1_2 .

mi:Exp_ECON_1_2_2 a mi:Expectation ;
  mi:expectationCode "1.2.2" ;
  mi:fullCode "ECON-1.2.2" ;
  mi:officialText "Market Structures - identify the characteristics of perfect competition,monopolistic competition, oligopoly, and monopoly market structures." ;
  skos:prefLabel "Market Structures" ;
  skos:broader mi:Cat_ECON_1_2 ;
  mi:inCategory mi:Cat_ECON_1_2 ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:hasExample
    mi:Example_exp_ECON_1_2_2_1 ;
  mi:isExpectationOf mi:Cat_ECON_1_2 .

mi:Exp_ECON_1_3_1 a mi:Expectation ;
  mi:expectationCode "1.3.1" ;
  mi:fullCode "ECON-1.3.1" ;
  mi:officialText "Supply And Demand - use the laws of supply and demand to explain household and business behavior." ;
  skos:prefLabel "Supply and Demand" ;
  skos:broader mi:Cat_ECON_1_3 ;
  mi:inCategory mi:Cat_ECON_1_3 ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:hasExample
    mi:Example_exp_ECON_1_3_1_1 ;
  mi:isExpectationOf mi:Cat_ECON_1_3 .

mi:Exp_ECON_1_3_2 a mi:Expectation ;
  mi:expectationCode "1.3.2" ;
  mi:fullCode "ECON-1.3.2" ;
  mi:officialText "Price, Equilibrium, Elasticity, and Incentives - analyze how prices change through the interaction of buyers and sellers in a market, including the role of supply, demand, equilibrium, and elasticity, and explain how incentives (monetary and non-monetary) affect choices of households and economic organizations." ;
  skos:prefLabel "Price, Equilibrium, Elasticity, and Incentives" ;
  skos:broader mi:Cat_ECON_1_3 ;
  mi:inCategory mi:Cat_ECON_1_3 ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:isExpectationOf mi:Cat_ECON_1_3 .

mi:Exp_ECON_1_4_1 a mi:Expectation ;
  mi:expectationCode "1.4.1" ;
  mi:fullCode "ECON-1.4.1" ;
  mi:officialText "Public Policy and the Market - analyze the impact of a change in public policy on consumers, producers, workers, savers, and investors." ;
  skos:prefLabel "Public Policy and the Market" ;
  skos:broader mi:Cat_ECON_1_4 ;
  mi:inCategory mi:Cat_ECON_1_4 ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:hasExample
    mi:Example_exp_ECON_1_4_1_1 ;
  mi:isExpectationOf mi:Cat_ECON_1_4 .

mi:Exp_ECON_1_4_2 a mi:Expectation ;
  mi:expectationCode "1.4.2" ;
  mi:fullCode "ECON-1.4.2" ;
  mi:officialText "Government and Consumers - analyze the role of government in protecting consumers and enforcing contracts (including property rights), and explain how this role influences the incentives (or disincentives) for people to produce and exchange goods and services." ;
  skos:prefLabel "Government and Consumers" ;
  skos:broader mi:Cat_ECON_1_4 ;
  mi:inCategory mi:Cat_ECON_1_4 ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:isExpectationOf mi:Cat_ECON_1_4 .

mi:Exp_ECON_1_4_3 a mi:Expectation ;
  mi:expectationCode "1.4.3" ;
  mi:fullCode "ECON-1.4.3" ;
  mi:officialText "Government Revenue and Services - analyze the ways in which local and state governments generate revenue and use that revenue to supply public services." ;
  skos:prefLabel "Government Revenue and Services" ;
  skos:broader mi:Cat_ECON_1_4 ;
  mi:inCategory mi:Cat_ECON_1_4 ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:isExpectationOf mi:Cat_ECON_1_4 .

mi:Exp_ECON_1_4_4 a mi:Expectation ;
  mi:expectationCode "1.4.4" ;
  mi:fullCode "ECON-1.4.4" ;
  mi:officialText "Market Failure - explain the role for government in addressing both negative and positive externalities." ;
  skos:prefLabel "Market Failure" ;
  skos:broader mi:Cat_ECON_1_4 ;
  mi:inCategory mi:Cat_ECON_1_4 ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:hasExample
    mi:Example_exp_ECON_1_4_4_1 ;
  mi:isExpectationOf mi:Cat_ECON_1_4 .

mi:Exp_ECON_1_4_5 a mi:Expectation ;
  mi:expectationCode "1.4.5" ;
  mi:fullCode "ECON-1.4.5" ;
  mi:officialText "Consequences of Governmental Policy - assess the incentives for political leaders to implement policies that disperse costs widely over large groups of people and benefit small and politically powerful groups." ;
  skos:prefLabel "Consequences of Governmental Policy" ;
  skos:broader mi:Cat_ECON_1_4 ;
  mi:inCategory mi:Cat_ECON_1_4 ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:hasExample
    mi:Example_exp_ECON_1_4_5_1 ;
  mi:isExpectationOf mi:Cat_ECON_1_4 .

mi:Exp_ECON_1_4_6 a mi:Expectation ;
  mi:expectationCode "1.4.6" ;
  mi:fullCode "ECON-1.4.6" ;
  mi:officialText "Price Controls - analyze the impact of price ceilings and price floors on the quantity of a good or service supplied and demanded in a market." ;
  skos:prefLabel "Price Controls" ;
  skos:broader mi:Cat_ECON_1_4 ;
  mi:inCategory mi:Cat_ECON_1_4 ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:isExpectationOf mi:Cat_ECON_1_4 .

mi:Exp_ECON_2_1_1 a mi:Expectation ;
  mi:expectationCode "2.1.1" ;
  mi:fullCode "ECON-2.1.1" ;
  mi:officialText "Circular Flow and the National Economy - using the concept of circular flow, analyze the roles of and relationship between households, business firms, and government in the economy of the United States." ;
  skos:prefLabel "Circular Flow and the National Economy" ;
  skos:broader mi:Cat_ECON_2_1 ;
  mi:inCategory mi:Cat_ECON_2_1 ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:isExpectationOf mi:Cat_ECON_2_1 .

mi:Exp_ECON_2_1_2 a mi:Expectation ;
  mi:expectationCode "2.1.2" ;
  mi:fullCode "ECON-2.1.2" ;
  mi:officialText "Economic Indicators - using a number of indicators, such as gross domestic product (GDP), per capita GDP, unemployment rates, and consumer price index, analyze the current and future state of an economy." ;
