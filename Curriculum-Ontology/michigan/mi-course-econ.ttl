#################################################################
# Categories
#################################################################
mi:Cat_ECON_1_1 a mi:StandardCategory ;
  mi:categoryCode "1.1" ;
  skos:prefLabel "Individual and Business Decision Making" ;
  mi:categoryDescription "Individually and collaboratively, students will engage in planned inquiries to explain and demonstrate how individuals confront scarcity, and how market forces influence how they organize, produce, use, and allocate resources in its presence." ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:hasExpectation
    mi:Exp_ECON_1_1_1 ,
    mi:Exp_ECON_1_1_2 ,
    mi:Exp_ECON_1_1_3 ;
  mi:isCategoryOf mi:Course_ECON .

mi:Cat_ECON_1_2 a mi:StandardCategory ;
  mi:categoryCode "1.2" ;
  skos:prefLabel "Competitive Markets" ;
  mi:categoryDescription "Individually and collaboratively, students will engage in planned inquiries to analyze how the functions and constraints of business structures, the role of price in the market, and relationships of investment to productivity and growth, impact competitive markets." ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:hasExpectation
    mi:Exp_ECON_1_2_1 ,
    mi:Exp_ECON_1_2_2 ;
  mi:isCategoryOf mi:Course_ECON .

mi:Cat_ECON_1_3 a mi:StandardCategory ;
  mi:categoryCode "1.3" ;
  skos:prefLabel "Prices, Supply, and Demand" ;
  mi:categoryDescription "Compare how supply, demand, price, equilibrium, elasticity, and incentives affect the workings of a market." ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:hasExpectation
    mi:Exp_ECON_1_3_1 ,
    mi:Exp_ECON_1_3_2 ;
  mi:isCategoryOf mi:Course_ECON .

mi:Cat_ECON_1_4 a mi:StandardCategory ;
  mi:categoryCode "1.4" ;
  skos:prefLabel "Government Impact on Households and Businesses" ;
  mi:categoryDescription "Individually and collaboratively, students will engage in planned inquiries to describe the varied ways in which government impacts households and businesses through policy decisions, regulatory laws, and ordinances, as well as apply key economic elements to how governments and markets allocate resources differently and explain why these differences matter in terms of growth and prosperity across the mass population." ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:hasExpectation
    mi:Exp_ECON_1_4_1 ,
    mi:Exp_ECON_1_4_2 ,
    mi:Exp_ECON_1_4_3 ,
    mi:Exp_ECON_1_4_4 ,
    mi:Exp_ECON_1_4_5 ,
    mi:Exp_ECON_1_4_6 ;
  mi:isCategoryOf mi:Course_ECON .

mi:Cat_ECON_2_1 a mi:StandardCategory ;
  mi:categoryCode "2.1" ;
  skos:prefLabel "Economic indicators in the Economy" ;
  mi:categoryDescription "Individually and collaboratively, students will engage in planned inquiries to explain why inflation, unemployment, output, and growth in potential output matter to consumers and producers, as well as associate stable money and interest rates with economic prosperity." ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:hasExpectation
    mi:Exp_ECON_2_1_1 ,
    mi:Exp_ECON_2_1_2 ;
  mi:isCategoryOf mi:Course_ECON .

mi:Cat_ECON_2_2 a mi:StandardCategory ;
  mi:categoryCode "2.2" ;
  skos:prefLabel "Role of Government in the U.S. Economy" ;
  mi:categoryDescription "Individually and collaboratively, students will engage in planned inquiries to analyze the role of government in the economy of the United States by identifying macroeconomic goals, comparing perspectives on government roles, analyzing fiscal and monetary policy, assessing the protective role of government, and describing the role of government as a producer and consumer of public goods and services." ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:hasExample
    mi:Example_cat_ECON_2_2_1 ;
  mi:hasExpectation
    mi:Exp_ECON_2_2_1 ,
    mi:Exp_ECON_2_2_2 ,
    mi:Exp_ECON_2_2_3 ,
    mi:Exp_ECON_2_2_4 ;
  mi:isCategoryOf mi:Course_ECON .

mi:Cat_ECON_3_1 a mi:StandardCategory ;
  mi:categoryCode "3.1" ;
  skos:prefLabel "Economic Systems" ;
  mi:categoryDescription "Individually and collaboratively, students will engage in planned inquiries to explain how different economic systems, including free market, command, and mixed systems, coordinate and facilitate the exchange, production, distribution, and consumption of goods and services." ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:hasExpectation
    mi:Exp_ECON_3_1_1 ,
    mi:Exp_ECON_3_1_2 ,
    mi:Exp_ECON_3_1_3 ,
    mi:Exp_ECON_3_1_4 ;
  mi:isCategoryOf mi:Course_ECON .

mi:Cat_ECON_3_2 a mi:StandardCategory ;
  mi:categoryCode "3.2" ;
  skos:prefLabel "Economic Interdependence - Trade" ;
  mi:categoryDescription "Individually and collaboratively, students will engage in planned inquiries to describe how trade generates economic development and interdependence, and analyze the benefits and costs for individuals, producers, and governments." ;
  mi:inCourse mi:Course_ECON ;
  mi:inDiscipline mi:Discipline_E ;
  mi:hasExpectation
    mi:Exp_ECON_3_2_1 ,
    mi:Exp_ECON_3_2_2 ,
    mi:Exp_ECON_3_2_3 ,
    mi:Exp_ECON_3_2_4 ;
  mi:isCategoryOf mi:Course_ECON .

