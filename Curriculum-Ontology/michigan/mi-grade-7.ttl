mi:Example_exp_7_P3_1_1_1 a mi:Example ;
  skos:prefLabel "Clearly state an issue as a question of public policy, trace the origins of an issue, analyze and synthesize various perspectives, and generate and evaluate alternative resolutions." ;
  mi:exampleText "Clearly state an issue as a question of public policy, trace the origins of an issue, analyze and synthesize various perspectives, and generate and evaluate alternative resolutions." .

