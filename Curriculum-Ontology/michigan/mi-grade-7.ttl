  skos:prefLabel "Share and discuss findings of research and issue analysis in group discussions and debates" ;
  mi:exampleText "Share and discuss findings of research and issue analysis in group discussions and debates" .

mi:Example_exp_7_P3_1_1_7 a mi:Example ;
  skos:prefLabel "Compose a persuasive essay justifying the position with a reasoned argument" ;
  mi:exampleText "Compose a persuasive essay justifying the position with a reasoned argument" .

mi:Example_exp_7_P3_1_1_8 a mi:Example ;
  skos:prefLabel "Develop an action plan to address or inform others about the issue at the local to global scales" ;
