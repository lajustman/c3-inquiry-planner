#################################################################
# Expectations
#################################################################
mi:Exp_7_C1_1_1 a mi:Expectation ;
  mi:expectationCode "C1.1.1" ;
  mi:fullCode "7-C1.1.1" ;
  mi:officialText "Explain how the purposes served by government affect relationships between the individual, government, and society as a whole and the differences that occur in monarchies, theocracies, dictatorships, and representative governments." ;
  skos:prefLabel "The Purposes Served" ;
  skos:broader mi:Cat_7_C1_1 ;
  mi:inCategory mi:Cat_7_C1_1 ;
  mi:inGrade mi:Grade_7 ;
  mi:inDiscipline mi:Discipline_C ;
  mi:isExpectationOf mi:Cat_7_C1_1 .

mi:Exp_7_C3_6_1 a mi:Expectation ;
  mi:expectationCode "C3.6.1" ;
  mi:fullCode "7-C3.6.1" ;
  mi:officialText "Define the characteristics of a nation-state (a specific territory, clearly defined boundaries, citizens, and jurisdiction over people who reside there, laws, and government) and how Eastern Hemisphere nations interact." ;
  skos:prefLabel "Define the Characteristics of a Nation-State" ;
  skos:broader mi:Cat_7_C3_6 ;
  mi:inCategory mi:Cat_7_C3_6 ;
  mi:inGrade mi:Grade_7 ;
  mi:inDiscipline mi:Discipline_C ;
  mi:isExpectationOf mi:Cat_7_C3_6 .

mi:Exp_7_C4_3_1 a mi:Expectation ;
  mi:expectationCode "C4.3.1" ;
  mi:fullCode "7-C4.3.1" ;
  mi:officialText "Explain how governments address national issues and form policies, and how the policies may not be consistent with those of other countries." ;
  skos:prefLabel "Governments Address National Issues and Form Policies" ;
  skos:broader mi:Cat_7_C4_3 ;
  mi:inCategory mi:Cat_7_C4_3 ;
  mi:inGrade mi:Grade_7 ;
  mi:inDiscipline mi:Discipline_C ;
  mi:hasExample
    mi:Example_exp_7_C4_3_1_1 ,
    mi:Example_exp_7_C4_3_1_2 ,
    mi:Example_exp_7_C4_3_1_3 ,
    mi:Example_exp_7_C4_3_1_4 ,
    mi:Example_exp_7_C4_3_1_5 ;
  mi:isExpectationOf mi:Cat_7_C4_3 .

mi:Exp_7_C4_3_2 a mi:Expectation ;
  mi:expectationCode "C4.3.2" ;
  mi:fullCode "7-C4.3.2" ;
  mi:officialText "Explain the challenges to governments and the cooperation needed to address international issues." ;
  skos:prefLabel "Challenges to Governments and the Cooperation Needed to Address International Issues" ;
  skos:broader mi:Cat_7_C4_3 ;
  mi:inCategory mi:Cat_7_C4_3 ;
  mi:inGrade mi:Grade_7 ;
  mi:inDiscipline mi:Discipline_C ;
  mi:hasExample
    mi:Example_exp_7_C4_3_2_1 ,
    mi:Example_exp_7_C4_3_2_2 ,
    mi:Example_exp_7_C4_3_2_3 ;
  mi:isExpectationOf mi:Cat_7_C4_3 .

mi:Exp_7_C4_3_3 a mi:Expectation ;
  mi:expectationCode "C4.3.3" ;
  mi:fullCode "7-C4.3.3" ;
  mi:officialText "Explain why governments belong to different types of international and regional organizations, North Atlantic Treaty Organization (NATO), Organization of the Petroleum Exporting Countries (OPEC), European Union (EU), and African Union (AU), G-8 countries (leading economic/political))." ;
  skos:prefLabel "Why Governments Belong to Different Types of International and Regional Organizations , North Atlantic Treaty..." ;
  skos:broader mi:Cat_7_C4_3 ;
  mi:inCategory mi:Cat_7_C4_3 ;
  mi:inGrade mi:Grade_7 ;
  mi:inDiscipline mi:Discipline_C ;
  mi:hasExample
    mi:Example_exp_7_C4_3_3_1 ;
  mi:isExpectationOf mi:Cat_7_C4_3 .

mi:Exp_7_E1_1_1 a mi:Expectation ;
  mi:expectationCode "E1.1.1" ;
  mi:fullCode "7-E1.1.1" ;
  mi:officialText "Explain the role of incentives in different economic systems (acquiring money, profit, goods, wanting to avoid loss, position in society, job placement)." ;
  skos:prefLabel "Role of Incentives in Different Economic Systems" ;
  skos:broader mi:Cat_7_E1_1 ;
  mi:inCategory mi:Cat_7_E1_1 ;
  mi:inGrade mi:Grade_7 ;
