  skos:prefLabel "Clearly state the issue as a question of public policy orally or in written form" ;
  mi:exampleText "Clearly state the issue as a question of public policy orally or in written form" .

mi:Example_exp_7_P3_1_1_4 a mi:Example ;
  skos:prefLabel "Use inquiry methods to acquire content knowledge and appropriate data about the issue" ;
  mi:exampleText "Use inquiry methods to acquire content knowledge and appropriate data about the issue" .

mi:Example_exp_7_P3_1_1_5 a mi:Example ;
  skos:prefLabel "Identify the causes and consequences and analyze the impact both positive and negative" ;
  mi:exampleText "Identify the causes and consequences and analyze the impact both positive and negative" .

