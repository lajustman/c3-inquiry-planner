  c3:inDimension c3:Dimension1 ;
  c3:isIndicatorOf c3:Inquiry ;
  dcterms:source "C3 Framework, Table 7, p. 23" .

c3:I_D1_5_6_8 a c3:Indicator ;
  c3:hasCode "D1.5.6-8" ;
  rdfs:label "Determine the kinds of sources that will be helpful in answering compelling and supporting questions, taking into consideration multiple points of view represented in the sources." ;
  skos:prefLabel "Determine the kinds of sources that will be helpful in answering compelling and supporting questions, taking into consideration multiple points of view represented in the sources." ;
  skos:altLabel "Indicator D1.5.6-8" ;
