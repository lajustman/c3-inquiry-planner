c3:I_D1_4_9_12 a c3:Indicator ;
  c3:hasCode "D1.4.9-12" ;
  rdfs:label "Explain how supporting questions contribute to an inquiry and how, through engaging source work, new compelling and supporting questions emerge." ;
  skos:prefLabel "Explain how supporting questions contribute to an inquiry and how, through engaging source work, new compelling and supporting questions emerge." ;
