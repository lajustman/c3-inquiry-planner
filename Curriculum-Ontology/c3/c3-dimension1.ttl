c3:I_D1_5_K_2 a c3:Indicator ;
  c3:hasCode "D1.5.K-2" ;
  rdfs:label "Determine the kinds of sources that will be helpful in answering compelling and supporting questions." ;
  skos:prefLabel "Determine the kinds of sources that will be helpful in answering compelling and supporting questions." ;
