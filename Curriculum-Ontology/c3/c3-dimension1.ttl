c3:I_D1_5_3_5 a c3:Indicator ;
  c3:hasCode "D1.5.3-5" ;
  rdfs:label "Determine the kinds of sources that will be helpful in answering compelling and supporting questions, taking into consideration the different opinions people have about how to answer the questions." ;
  skos:prefLabel "Determine the kinds of sources that will be helpful in answering compelling and supporting questions, taking into consideration the different opinions people have about how to answer the questions." ;
