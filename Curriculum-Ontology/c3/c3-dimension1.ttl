c3:I_D1_5_9_12 a c3:Indicator ;
  c3:hasCode "D1.5.9-12" ;
  rdfs:label "Determine the kinds of sources that will be helpful in answering compelling and supporting questions, taking into consideration multiple points of view represented in the sources, the types of sources available, and the potential uses of the sources." ;
  skos:prefLabel "Determine the kinds of sources that will be helpful in answering compelling and supporting questions, taking into consideration multiple points of view represented in the sources, the types of sources available, and the potential uses of the sources." ;
