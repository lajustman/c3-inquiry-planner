<c3-dimension2-geography.ttl> a owl:Ontology ;
  rdfs:label "C3 Framework — Dimension 2 Geography" ;
  dcterms:description "Dimension 2 Geography indicators with SKOS alignment and provenance." ;
  dcterms:creator "NCSS — College, Career, and Civic Life (C3) Framework for Social Studies State Standards" ;
  dcterms:source "C3 Framework, pp. 31–49" .

#################################################################
# Annotation properties
#################################################################

c3:status        a owl:AnnotationProperty .
