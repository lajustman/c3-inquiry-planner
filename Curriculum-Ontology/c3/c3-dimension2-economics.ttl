c3:sourceDoc     a owl:AnnotationProperty .
c3:sourcePage    a owl:AnnotationProperty .

#################################################################
# Indicators
#################################################################

c3:I_D2_Eco_1_K_2 a c3:Indicator ;
  c3:hasCode "D2.Eco.1.K-2" ; rdfs:label "Explain how scarcity necessitates decision making." ;
  skos:prefLabel "Explain how scarcity necessitates decision making." ;
  skos:altLabel "Indicator D2.Eco.1.K-2" ;
  c3:officialText "Explain how scarcity necessitates decision making." ;
  c3:targetsGradeBand c3:K_2 ; c3:addressesConcept c3:Scarcity , c3:EconomicDecisionMaking , c3:CostsBenefits ; c3:requiresSkill c3:Explain ;
  c3:inStrand c3:Str_Eco_DecisionMaking ; c3:inDimension c3:Dimension2 ; c3:isIndicatorOf c3:Economics ;
  dcterms:source "C3 Framework, Table 12, p. 36" .

c3:I_D2_Eco_1_3_5 a c3:Indicator ;
