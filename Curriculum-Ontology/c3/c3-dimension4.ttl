  c3:inStrand c3:Str_D4_TakingAction ; c3:inDimension c3:Dimension4 ; c3:isIndicatorOf c3:CommAction ;
  dcterms:source "C3 Framework, Table 30, p. 62" .

c3:I_D4_7_K_2 a c3:Indicator ;
  c3:hasCode "D4.7.K-2" ; rdfs:label "Identify ways to take action to help address local, regional, and global problems." ;
