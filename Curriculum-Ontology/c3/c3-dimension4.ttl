c3:I_D4_6_3_5 a c3:Indicator ;
  c3:hasCode "D4.6.3-5" ; rdfs:label "Draw on disciplinary concepts to explain the challenges people have faced and opportunities they have created, in addressing local, regional, and global problems at various times and places." ;
