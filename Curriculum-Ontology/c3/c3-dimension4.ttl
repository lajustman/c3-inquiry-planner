<c3-dimension4.ttl> a owl:Ontology ;
  rdfs:label "C3 Framework — Dimension 4 Module" ;
  dcterms:description "Modular slice of the C3 Framework capturing Dimension 4 (Communicating Conclusions & Taking Informed Action) with SKOS-aligned labels and provenance." ;
  dcterms:creator "NCSS — College, Career, and Civic Life (C3) Framework for Social Studies State Standards" ;
  dcterms:source "C3 Framework, pp. 60–63" .

#################################################################
# Annotation properties
#################################################################

c3:status        a owl:AnnotationProperty .
c3:createdOn     a owl:AnnotationProperty .
c3:alignmentNote a owl:AnnotationProperty .
c3:officialText  a owl:AnnotationProperty .
c3:sourceDoc     a owl:AnnotationProperty .
c3:sourcePage    a owl:AnnotationProperty .

#################################################################
# Property alignment with SKOS navigation
#################################################################

c3:hasDomain     rdfs:subPropertyOf skos:narrower .
c3:hasStrand     rdfs:subPropertyOf skos:narrower .
c3:hasIndicator  rdfs:subPropertyOf skos:narrower .

#################################################################
# Dimension 4 — Core structure
#################################################################

c3:Dimension4 a c3:Dimension ;
  rdfs:label "Dimension 4: Communicating Conclusions & Taking Informed Action" ;
  skos:prefLabel "Dimension 4: Communicating Conclusions & Taking Informed Action" ;
  skos:altLabel "D4" ;
  c3:status "official" ;
  c3:sourceDoc "NCSS — College, Career, and Civic Life (C3) Framework for Social Studies State Standards" ;
  c3:sourcePage "60" ;
  c3:createdOn "2025-11-02"^^xsd:date .

c3:CommAction a c3:DisciplinaryDomain ;
  rdfs:label "Communicating Conclusions & Taking Informed Action" ;
  skos:prefLabel "Communicating Conclusions & Taking Informed Action" ;
  skos:altLabel "Dimension 4 Domain" ;
  c3:status "official" ;
  c3:sourcePage "60" ;
  c3:alignmentNote "Domain combining the communication/critique and informed action strands of Dimension 4." .

c3:Dimension4 c3:hasDomain c3:CommAction .

#################################################################
# Strands (Dimension 4)
#################################################################

c3:Str_D4_CommunicateCritique a c3:Strand ;
  rdfs:label "Communicating & Critiquing Conclusions" ;
  skos:prefLabel "Communicating & Critiquing Conclusions" ;
  skos:altLabel "D4.1–D4.5 — Communicating & Critiquing" ;
  c3:status "official" ;
  c3:sourcePage "61" .

c3:Str_D4_TakingAction a c3:Strand ;
  rdfs:label "Taking Informed Action" ;
  skos:prefLabel "Taking Informed Action" ;
  skos:altLabel "D4.6–D4.8 — Taking Informed Action" ;
  c3:status "official" ;
  c3:sourcePage "62" .

c3:CommAction c3:hasStrand
  c3:Str_D4_CommunicateCritique ,
  c3:Str_D4_TakingAction .

#################################################################
# Indicators — Dimension 4
#################################################################

c3:I_D4_1_K_2 a c3:Indicator ;
  c3:hasCode "D4.1.K-2" ; rdfs:label "Construct an argument with reasons." ;
  skos:prefLabel "Construct an argument with reasons." ;
  skos:altLabel "Indicator D4.1.K-2" ;
  c3:officialText "Construct an argument with reasons." ;
  c3:targetsGradeBand c3:K_2 ; c3:addressesConcept c3:Argumentation, c3:SourcesEvidence ; c3:requiresSkill c3:ConstructClaim ;
  c3:inStrand c3:Str_D4_CommunicateCritique ; c3:inDimension c3:Dimension4 ; c3:isIndicatorOf c3:CommAction ;
  dcterms:source "C3 Framework, Table 27, p. 61" .

c3:I_D4_1_3_5 a c3:Indicator ;
  c3:hasCode "D4.1.3-5" ; rdfs:label "Construct arguments using claims and evidence from multiple sources." ;
  skos:prefLabel "Construct arguments using claims and evidence from multiple sources." ;
  skos:altLabel "Indicator D4.1.3-5" ;
  c3:officialText "Construct arguments using claims and evidence from multiple sources." ;
  c3:targetsGradeBand c3:G3_5 ; c3:addressesConcept c3:Argumentation, c3:SourcesEvidence ; c3:requiresSkill c3:ConstructClaim, c3:Explain ;
  c3:inStrand c3:Str_D4_CommunicateCritique ; c3:inDimension c3:Dimension4 ; c3:isIndicatorOf c3:CommAction ;
  dcterms:source "C3 Framework, Table 27, p. 61" .

c3:I_D4_1_6_8 a c3:Indicator ;
  c3:hasCode "D4.1.6-8" ; rdfs:label "Construct arguments using claims and evidence from multiple sources, while acknowledging the strengths and limitations of the arguments." ;
  skos:prefLabel "Construct arguments using claims and evidence from multiple sources, while acknowledging the strengths and limitations of the arguments." ;
  skos:altLabel "Indicator D4.1.6-8" ;
  c3:officialText "Construct arguments using claims and evidence from multiple sources, while acknowledging the strengths and limitations of the arguments." ;
  c3:targetsGradeBand c3:G6_8 ; c3:addressesConcept c3:Argumentation, c3:SourcesEvidence ; c3:requiresSkill c3:ConstructClaim, c3:Evaluate ;
  c3:inStrand c3:Str_D4_CommunicateCritique ; c3:inDimension c3:Dimension4 ; c3:isIndicatorOf c3:CommAction ;
  dcterms:source "C3 Framework, Table 27, p. 61" .

c3:I_D4_1_9_12 a c3:Indicator ;
  c3:hasCode "D4.1.9-12" ; rdfs:label "Construct arguments using precise and knowledgeable claims, with evidence from multiple sources, while acknowledging counterclaims and evidentiary weaknesses." ;
  skos:prefLabel "Construct arguments using precise and knowledgeable claims, with evidence from multiple sources, while acknowledging counterclaims and evidentiary weaknesses." ;
  skos:altLabel "Indicator D4.1.9-12" ;
  c3:officialText "Construct arguments using precise and knowledgeable claims, with evidence from multiple sources, while acknowledging counterclaims and evidentiary weaknesses." ;
  c3:targetsGradeBand c3:G9_12 ; c3:addressesConcept c3:Argumentation, c3:SourcesEvidence ; c3:requiresSkill c3:ConstructClaim, c3:Synthesize, c3:Evaluate ;
  c3:inStrand c3:Str_D4_CommunicateCritique ; c3:inDimension c3:Dimension4 ; c3:isIndicatorOf c3:CommAction ;
  dcterms:source "C3 Framework, Table 27, p. 61" .

c3:I_D4_2_K_2 a c3:Indicator ;
  c3:hasCode "D4.2.K-2" ; rdfs:label "Construct explanations using correct sequence and relevant information." ;
  skos:prefLabel "Construct explanations using correct sequence and relevant information." ;
  skos:altLabel "Indicator D4.2.K-2" ;
  c3:officialText "Construct explanations using correct sequence and relevant information." ;
  c3:targetsGradeBand c3:K_2 ; c3:addressesConcept c3:ReasonedJudgment, c3:SourcesEvidence ; c3:requiresSkill c3:Explain ;
  c3:inStrand c3:Str_D4_CommunicateCritique ; c3:inDimension c3:Dimension4 ; c3:isIndicatorOf c3:CommAction ;
  dcterms:source "C3 Framework, Table 27, p. 61" .

c3:I_D4_2_3_5 a c3:Indicator ;
  c3:hasCode "D4.2.3-5" ; rdfs:label "Construct explanations using reasoning, correct sequence, examples, and details with relevant information and data." ;
  skos:prefLabel "Construct explanations using reasoning, correct sequence, examples, and details with relevant information and data." ;
  skos:altLabel "Indicator D4.2.3-5" ;
  c3:officialText "Construct explanations using reasoning, correct sequence, examples, and details with relevant information and data." ;
  c3:targetsGradeBand c3:G3_5 ; c3:addressesConcept c3:ReasonedJudgment, c3:SourcesEvidence ; c3:requiresSkill c3:Explain ;
