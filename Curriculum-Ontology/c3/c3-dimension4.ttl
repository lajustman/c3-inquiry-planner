  dcterms:source "C3 Framework, Table 27, p. 61" .

c3:I_D4_2_6_8 a c3:Indicator ;
  c3:hasCode "D4.2.6-8" ; rdfs:label "Construct explanations using reasoning, correct sequence, examples, and details with relevant information and data, while acknowledging the strengths and weaknesses of the explanations." ;
  skos:prefLabel "Construct explanations using reasoning, correct sequence, examples, and details with relevant information and data, while acknowledging the strengths and weaknesses of the explanations." ;
  skos:altLabel "Indicator D4.2.6-8" ;
  c3:officialText "Construct explanations using reasoning, correct sequence, examples, and details with relevant information and data, while acknowledging the strengths and weaknesses of the explanations." ;
