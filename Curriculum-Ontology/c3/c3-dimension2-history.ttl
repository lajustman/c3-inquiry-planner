<c3-dimension2-history.ttl> a owl:Ontology ;
  rdfs:label "C3 Framework — Dimension 2 History" ;
  dcterms:description "Dimension 2 History indicators with SKOS alignment and provenance." ;
  dcterms:creator "NCSS — College, Career, and Civic Life (C3) Framework for Social Studies State Standards" ;
  dcterms:source "C3 Framework, pp. 31–49" .

#################################################################
# Annotation properties
#################################################################

c3:status        a owl:AnnotationProperty .
c3:createdOn     a owl:AnnotationProperty .
c3:alignmentNote a owl:AnnotationProperty .
c3:officialText  a owl:AnnotationProperty .
c3:sourceDoc     a owl:AnnotationProperty .
c3:sourcePage    a owl:AnnotationProperty .

